@moduledoc """
HTTP health endpoint for probes: `GET /health` is 200 while the pipeline process
is alive, 503 when it is not, and everything else is 404.
"""

use Plug.Router

plug(:match)
plug(:dispatch)

get "/health" do
  case Process.whereis(<%= inspect(@pipeline) %>) do
    pid when is_pid(pid) -> send_resp(conn, 200, ~s({"status":"ok"}))
    nil -> send_resp(conn, 503, ~s({"status":"degraded"}))
  end
end

match _ do
  send_resp(conn, 404, ~s({"error":"not_found"}))
end
