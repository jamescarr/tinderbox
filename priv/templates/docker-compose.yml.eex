name: <%= @app %>

# Backing services for local development. The application runs on the host
# (`mix phx.server` / `mix run --no-halt`), so every endpoint is published on
# localhost. FLOCI_HOSTNAME is intentionally unset: Floci then embeds
# `localhost` in generated SQS queue URLs and pre-signed URLs, which is what a
# host-side app needs. See https://floci.io.
#
#   docker compose up -d --wait
#   cp .env.example .env && . ./.env   # every line is exported; mise users get the same from .mise.toml
#   mix ash.setup

services:
<%= if @db? do %>  postgres:
    image: postgres:17-alpine
    # Host ports come from the environment (.mise.toml, overridable in .mise.local.toml).
    ports:
      - "${PGPORT:-5432}:5432"
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: <%= @app %>_dev
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 5s
      retries: 30

<% end %>  # AWS emulator: S3 + SQS.
  floci:
    image: floci/floci:latest
    ports:
      - "4566:4566"
    environment:
      FLOCI_DEFAULT_REGION: us-east-1
      FLOCI_STORAGE_MODE: persistent
      FLOCI_STORAGE_PERSISTENT_PATH: /app/data
    volumes:
      - floci-data:/app/data

  # GCP emulator: GCS + Pub/Sub.
  floci-gcp:
    image: floci/floci-gcp:latest
    ports:
      - "4588:4588"
    environment:
      FLOCI_GCP_DEFAULT_PROJECT_ID: floci-local
      FLOCI_GCP_STORAGE_MODE: hybrid
      FLOCI_GCP_STORAGE_PERSISTENT_PATH: /app/data
    volumes:
      - floci-gcp-data:/app/data

  # Creates the S3 bucket and the two SQS queues. Idempotent; runs to completion.
  aws-bootstrap:
    image: amazon/aws-cli:2.17.62
    depends_on: [floci]
    environment:
      AWS_ACCESS_KEY_ID: test
      AWS_SECRET_ACCESS_KEY: test
      AWS_DEFAULT_REGION: us-east-1
      AWS_ENDPOINT_URL: http://floci:4566
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        until aws s3 ls >/dev/null 2>&1; do echo "waiting for floci..."; sleep 1; done
        aws s3 mb s3://<%= @app_dash %>-local || true
        aws sqs create-queue --queue-name <%= @app_dash %>-inbound || true
        aws sqs create-queue --queue-name <%= @app_dash %>-outbound || true
        echo "floci bootstrap done"

  # Creates the GCS bucket, the Pub/Sub topics and the inbound subscription.
  gcp-bootstrap:
    image: curlimages/curl:8.10.1
    depends_on: [floci-gcp]
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        until curl -sf http://floci-gcp:4588/health >/dev/null 2>&1; do echo "waiting for floci-gcp..."; sleep 1; done
        curl -sf -X POST "http://floci-gcp:4588/storage/v1/b?project=floci-local" \
          -H 'Content-Type: application/json' -d '{"name":"<%= @app_dash %>-local"}' || true
        curl -sf -X PUT "http://floci-gcp:4588/v1/projects/floci-local/topics/<%= @app_dash %>-inbound" \
          -H 'Content-Type: application/json' -d '{}' || true
        curl -sf -X PUT "http://floci-gcp:4588/v1/projects/floci-local/topics/<%= @app_dash %>-outbound" \
          -H 'Content-Type: application/json' -d '{}' || true
        curl -sf -X PUT "http://floci-gcp:4588/v1/projects/floci-local/subscriptions/<%= @app_dash %>-inbound-sub" \
          -H 'Content-Type: application/json' \
          -d '{"topic":"projects/floci-local/topics/<%= @app_dash %>-inbound","ackDeadlineSeconds":30}' || true
        echo "floci-gcp bootstrap done"
<%= if @extra_service == :rabbitmq do %>
  rabbitmq:
    image: rabbitmq:4-management-alpine
    ports:
      - "5672:5672"
      - "15672:15672"  # management UI, http://localhost:15672 (guest/guest)
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 2s
      timeout: 5s
      retries: 30
<% end %><%= if @extra_service == :redpanda do %>
  redpanda:
    image: docker.redpanda.com/redpandadata/redpanda:v26.2.3
    command:
      - redpanda
      - start
      - --mode=dev-container
      - --smp=1
      - --kafka-addr=internal://0.0.0.0:9092,external://0.0.0.0:19092
      - --advertise-kafka-addr=internal://redpanda:9092,external://localhost:19092
    ports:
      - "19092:19092"
    healthcheck:
      test: ["CMD-SHELL", "rpk cluster health | grep -q 'Healthy:.*true'"]
      interval: 2s
      timeout: 5s
      retries: 30

  redpanda-bootstrap:
    image: docker.redpanda.com/redpandadata/redpanda:v26.2.3
    depends_on:
      redpanda:
        condition: service_healthy
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        rpk topic create <%= @app_dash %>-inbound -X brokers=redpanda:9092 || true
        rpk topic create <%= @app_dash %>-outbound -X brokers=redpanda:9092 || true
<% end %><%= if @extra_service == :nats do %>
  # NATS with JetStream: the worker stack's broker, the SaaS stack's event bus.
  nats:
    image: nats:2.15-alpine
    command: ["--jetstream", "--store_dir", "/data", "--http_port", "8222"]
    ports:
      - "4222:4222"
      - "8222:8222"  # monitoring, http://localhost:8222
    volumes:
      - nats-data:/data
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:8222/healthz"]
      interval: 2s
      timeout: 5s
      retries: 30
<%= if @stack == "worker" do %>
  # Creates the inbound/outbound streams and the worker's durable pull consumer.
  # (The SaaS stack creates its own stream from the application.)
  nats-bootstrap:
    image: natsio/nats-box:0.20.0
    depends_on:
      nats:
        condition: service_healthy
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        nats --server nats://nats:4222 stream add <%= @app_dash %>-inbound --subjects "<%= @app_dash %>.inbound" --storage file --retention limits --defaults || true
        nats --server nats://nats:4222 stream add <%= @app_dash %>-outbound --subjects "<%= @app_dash %>.outbound" --storage file --retention limits --defaults || true
        nats --server nats://nats:4222 consumer add <%= @app_dash %>-inbound <%= @app_dash %>-worker --pull --deliver all --ack explicit --max-deliver 10 --defaults || true
        echo "nats bootstrap done"
<% end %><% end %><%= if @stack == "saas" do %>
  # OIDC provider for local SSO, http://localhost:5556/dex. Sign in with
  # admin@example.com / password. See docker/dex/config.yaml.
  dex:
    image: dexidp/dex:v2.46.0
    command: ["dex", "serve", "/etc/dex/config.yaml"]
    ports:
      - "5556:5556"
    volumes:
      - ./docker/dex/config.yaml:/etc/dex/config.yaml:ro
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:5556/dex/healthz"]
      interval: 2s
      timeout: 5s
      retries: 30

  # SMTP sink (1025) with a web inbox, http://localhost:8025 (host ports:
  # SMTP_PORT, MAILPIT_UI_PORT). Ships its own healthcheck.
  mailpit:
    image: axllent/mailpit:v1.31
    ports:
      - "${SMTP_PORT:-1025}:1025"
      - "${MAILPIT_UI_PORT:-8025}:8025"
<% end %>
  # Stays up once every bootstrap job above has finished. Compose fails
  # `up --wait` when a job container merely exits, even with status 0, unless a
  # running service depends on it completing: this is that service. It also means
  # `docker compose up -d --wait` returns only after the queues, topics and
  # buckets exist.
  ready:
    image: curlimages/curl:8.10.1
    # `sleep` as PID 1 ignores SIGTERM, so without an init `docker compose down`
    # sits out Docker's 10s stop timeout (measured: 10.4s, vs 0.3s with `init`).
    init: true
    entrypoint: ["sleep", "infinity"]
    depends_on:
      aws-bootstrap:
        condition: service_completed_successfully
      gcp-bootstrap:
        condition: service_completed_successfully
<%= if @extra_service == :redpanda do %>      redpanda-bootstrap:
        condition: service_completed_successfully
<% end %><%= if @extra_service == :nats and @stack == "worker" do %>      nats-bootstrap:
        condition: service_completed_successfully
<% end %>
volumes:
<%= if @db? do %>  pgdata:
<% end %>  floci-data:
  floci-gcp-data:
<%= if @extra_service == :nats do %>  nats-data:
<% end %>
