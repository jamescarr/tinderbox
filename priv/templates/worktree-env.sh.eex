#!/bin/sh
# generated by bin/worktree-env
#
# Give this checkout its own host ports and compose project, so several
# worktrees of the project can run their services at the same time.
#
#   sh bin/worktree-env            # write .mise.local.toml; then: mise trust
#   sh bin/worktree-env --force    # overwrite a .mise.local.toml this did not write
#
# Every host port docker-compose.yml publishes is a variable (PGPORT,
# FLOCI_PORT, DEX_PORT, …), and mise layers .mise.local.toml over .mise.toml, so
# this one file moves the whole stack. The block is 12 consecutive ports picked
# from the checkout's path: two worktrees of one project never share one, and
# running it twice gives the same block back.
set -eu

MARKER='# generated by bin/worktree-env'
CONFIG=.mise.local.toml
BLOCK=12

cd "$(dirname "$0")/.."

if [ -f "$CONFIG" ]; then
  if ! grep -qxF "$MARKER" "$CONFIG"; then
    if [ "${1:-}" != "--force" ]; then
      echo "worktree-env: $CONFIG exists and was not written by this script; rerun with --force to overwrite" >&2
      exit 1
    fi
  elif [ "${1:-}" != "--force" ]; then
    echo "worktree-env: already configured"
    exit 0
  fi
fi

# 20000 + index * 20 with index in 0..399 keeps every block inside
# 20000-27999 and leaves room between blocks for something else that needs a port.
index=$(printf '%s' "$(pwd)" | cksum | cut -d' ' -f1)
index=$((index % 400))
tries=0
base=

while [ "$tries" -lt 400 ]; do
  candidate=$((20000 + index * 20))
  busy=
  offset=0

  while [ "$offset" -lt "$BLOCK" ]; do
    if nc -z 127.0.0.1 $((candidate + offset)) >/dev/null 2>&1; then
      busy=1
      break
    fi

    offset=$((offset + 1))
  done

  if [ -z "$busy" ]; then
    base=$candidate
    break
  fi

  index=$(((index + 1) % 400))
  tries=$((tries + 1))
done

if [ -z "$base" ]; then
  echo "worktree-env: every block of $BLOCK ports in 20000-27999 is in use" >&2
  exit 1
fi

# <app>-<parent directory>-<directory>, for a compose project name that names the
# checkout in `docker compose ls`.
slug=$(printf '%s-%s' "$(basename "$(dirname "$(pwd)")")" "$(basename "$(pwd)")" |
  tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '-' | cut -c1-40)

cat >"$CONFIG" <<EOF
$MARKER
[env]
COMPOSE_PROJECT_NAME = "<%= @app_dash %>-$slug"
# The app (config/runtime.exs) and config/dev.exs + config/test.exs read PORT and
# PGPORT; the rest are the host ports compose publishes.
PORT = "$((base + 0))"
PGPORT = "$((base + 1))"
SMTP_PORT = "$((base + 2))"
MAILPIT_UI_PORT = "$((base + 3))"
FLOCI_PORT = "$((base + 4))"
FLOCI_GCP_PORT = "$((base + 5))"
NATS_PORT = "$((base + 6))"
NATS_MONITOR_PORT = "$((base + 7))"
DEX_PORT = "$((base + 8))"
HYDRA_PUBLIC_PORT = "$((base + 9))"
HYDRA_ADMIN_PORT = "$((base + 10))"
CLAMAV_PORT = "$((base + 11))"
AWS_ENDPOINT_URL = "http://localhost:$((base + 4))"
STORAGE_EMULATOR_HOST = "http://localhost:$((base + 5))"
EOF
<%= if @stack == "saas" do %>
cat >>"$CONFIG" <<EOF
SSO_BASE_URL = "http://localhost:$((base + 8))/dex"
SSO_REDIRECT_URI = "http://localhost:$((base + 0))/auth"
OAUTH_ISSUER = "http://localhost:$((base + 9))/"
OAUTH_AUDIENCE = "http://localhost:$((base + 0))/api"
HYDRA_ADMIN_URL = "http://localhost:$((base + 10))"
DEX_CONFIG = "./docker/dex/config.local.yaml"
EOF

# Dex reads its issuer and redirect URIs from a file, so it gets a copy pointed at
# this checkout's ports instead of the defaults (5556 for Dex, 4000 for the app).
sed -e "s#localhost:5556#localhost:$((base + 8))#g" \
  -e "s#localhost:4000#localhost:$((base + 0))#g" \
  docker/dex/config.yaml >docker/dex/config.local.yaml
<% end %>
echo "worktree-env: compose project <%= @app_dash %>-$slug, ports $base-$((base + 11))"
echo "worktree-env: PORT=$((base + 0)) PGPORT=$((base + 1)) SMTP_PORT=$((base + 2)) MAILPIT_UI_PORT=$((base + 3)) FLOCI_PORT=$((base + 4)) FLOCI_GCP_PORT=$((base + 5)) NATS_PORT=$((base + 6)) NATS_MONITOR_PORT=$((base + 7)) DEX_PORT=$((base + 8)) HYDRA_PUBLIC_PORT=$((base + 9)) HYDRA_ADMIN_PORT=$((base + 10)) CLAMAV_PORT=$((base + 11))"
echo "next: mise trust"
