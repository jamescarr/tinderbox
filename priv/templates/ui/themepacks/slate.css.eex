/* tinderbox:themepack slate — rewritten by `mix tinderbox.gen.ui --themepack <name>`; customize outside these markers */
/* Slate: neutral grays with indigo, compact: built for dense tool UIs. Themes are named "light" and "dark" so Phoenix's theme toggle and `dark:` variant keep working. */
@plugin "<%= @theme_plugin %>" {
  name: "light";
  default: true;
  prefersdark: false;
  color-scheme: "light";
  --color-base-100: oklch(100% 0 0);
  --color-base-200: oklch(98% 0.003 265);
  --color-base-300: oklch(93% 0.006 265);
  --color-base-content: oklch(21% 0.02 265);
  --color-primary: oklch(52% 0.2 275);
  --color-primary-content: oklch(98% 0.01 275);
  --color-secondary: oklch(55% 0.02 265);
  --color-secondary-content: oklch(98% 0.003 265);
  --color-accent: oklch(65% 0.15 195);
  --color-accent-content: oklch(98% 0.01 195);
  --color-neutral: oklch(25% 0.02 265);
  --color-neutral-content: oklch(98% 0.003 265);
  --color-info: oklch(60% 0.15 245);
  --color-info-content: oklch(98% 0.01 245);
  --color-success: oklch(62% 0.14 160);
  --color-success-content: oklch(98% 0.02 160);
  --color-warning: oklch(75% 0.15 75);
  --color-warning-content: oklch(25% 0.05 70);
  --color-error: oklch(58% 0.21 22);
  --color-error-content: oklch(98% 0.01 22);
  --radius-selector: 0.25rem;
  --radius-field: 0.375rem;
  --radius-box: 0.5rem;
  --size-selector: 0.1875rem;
  --size-field: 0.1875rem;
  --border: 1px;
  --depth: 0;
  --noise: 0;
}

@plugin "<%= @theme_plugin %>" {
  name: "dark";
  default: false;
  prefersdark: true;
  color-scheme: "dark";
  --color-base-100: oklch(20% 0.012 265);
  --color-base-200: oklch(17% 0.01 265);
  --color-base-300: oklch(14% 0.008 265);
  --color-base-content: oklch(93% 0.008 265);
  --color-primary: oklch(66% 0.17 275);
  --color-primary-content: oklch(16% 0.03 275);
  --color-secondary: oklch(70% 0.02 265);
  --color-secondary-content: oklch(17% 0.01 265);
  --color-accent: oklch(74% 0.13 195);
  --color-accent-content: oklch(17% 0.02 195);
  --color-neutral: oklch(28% 0.015 265);
  --color-neutral-content: oklch(93% 0.008 265);
  --color-info: oklch(70% 0.13 245);
  --color-info-content: oklch(17% 0.03 245);
  --color-success: oklch(72% 0.14 160);
  --color-success-content: oklch(17% 0.03 160);
  --color-warning: oklch(80% 0.14 75);
  --color-warning-content: oklch(20% 0.04 70);
  --color-error: oklch(66% 0.19 22);
  --color-error-content: oklch(98% 0.01 22);
  --radius-selector: 0.25rem;
  --radius-field: 0.375rem;
  --radius-box: 0.5rem;
  --size-selector: 0.1875rem;
  --size-field: 0.1875rem;
  --border: 1px;
  --depth: 0;
  --noise: 0;
}

@theme {
  --font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-display: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
/* tinderbox:themepack:end */
