@moduledoc """
This module holds layouts and related functionality
used by your application.
"""
use <%= inspect(@web) %>, :html

# Embed all files in layouts/* within this module.
# The default root.html.heex file contains the HTML
# skeleton of your application, namely HTML headers
# and other static content.
embed_templates "layouts/*"

@doc """
Renders the application layout: the themepack's app shell
(`<%= inspect(@web) %>.UI.Shell`) with the navigation, the inbox badge, the organization
switcher and the user menu. Signed-in pages get the pack's shell (a sidebar or a
top bar); signed-out pages always get the top bar.

LiveViews pass what `<%= inspect(@web) %>.LiveUserAuth`, `<%= inspect(@web) %>.LiveOrganization` and
`<%= inspect(@web) %>.LiveNotifications` assigned, plus `current_page` to highlight its
navigation entry; pages without a signed-in user pass only `flash`.

## Examples

    <Layouts.app flash={@flash} current_user={@current_user} unread_count={@unread_count} current_page={:inbox}>
      <h1>Content</h1>
    </Layouts.app>

"""
attr :flash, :map, required: true, doc: "the map of flash messages"
attr :current_user, :any, default: nil, doc: "the signed-in user, if any"
attr :current_organization, :any, default: nil, doc: "the organization the user is working in"
attr :organizations, :list, default: [], doc: "every organization the user belongs to"
attr :unread_count, :integer, default: 0, doc: "unread in-app notifications"
attr :wide, :boolean, default: false, doc: "a wider column, for pages made of tables"
attr :current_page, :atom, default: nil, doc: "the navigation entry to highlight"

slot :inner_block, required: true

def app(assigns) do
  ~H"""
  <.app_shell
    variant={if @current_user, do: nil, else: :topnav}
    width={if @wide, do: :wide, else: :default}
  >
    <:brand>
      <.link navigate={~p"/"} class="flex items-center gap-2 font-display text-lg font-semibold">
        <.icon name="hero-fire" class="size-6 text-primary" /> {<%= inspect(@prefix) %>.Concept.name()}
      </.link>
    </:brand>

    <:nav :if={@current_user}>
      <.nav_item
        navigate={~p"/dashboard"}
        icon="hero-squares-2x2"
        active={@current_page == :dashboard}
      >
        Dashboard
      </.nav_item>
      <.nav_item
        navigate={~p"/inbox"}
        icon="hero-inbox"
        active={@current_page == :inbox}
        badge={@unread_count}
      >
        Inbox
      </.nav_item>
      <.nav_item
        navigate={~p"/organizations/members"}
        icon="hero-users"
        active={@current_page == :members}
      >
        Members
      </.nav_item>
      <.nav_item navigate={~p"/billing"} icon="hero-credit-card" active={@current_page == :billing}>
        Billing
      </.nav_item>
      <.nav_item
        navigate={~p"/connections"}
        icon="hero-key"
        active={@current_page == :connections}
      >
        API connections
      </.nav_item>
      <.nav_section :if={@current_user.role == :admin} label="Platform">
        <.nav_item href={~p"/admin"} icon="hero-shield-check">Admin</.nav_item>
      </.nav_section>
    </:nav>

    <:nav_footer :if={@current_user}>
      <li :if={length(@organizations) > 1} class="pb-1">
        <form
          method="post"
          action={~p"/organizations/switch"}
          class="block cursor-default p-0 hover:bg-transparent active:bg-transparent"
        >
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <select
            name="id"
            class="select select-sm w-full"
            aria-label="Switch organization"
            onchange="this.form.submit()"
          >
            <option
              :for={organization <- @organizations}
              value={organization.id}
              selected={@current_organization && organization.id == @current_organization.id}
            >
              {organization.name}
            </option>
          </select>
        </form>
      </li>
      <.nav_item
        navigate={~p"/organizations/new"}
        icon="hero-plus"
        active={@current_page == :new_organization}
      >
        New organization
      </.nav_item>
      <.nav_item :if={dev_routes?()} navigate="/dev/ui" icon="hero-swatch">UI kit</.nav_item>
    </:nav_footer>

    <:topbar>
      <.theme_toggle />
      <.user_menu :if={@current_user} name={to_string(@current_user.email)}>
        <:item navigate={~p"/settings/notifications"}>Notification settings</:item>
        <:item href={~p"/sign-out"}>Sign out</:item>
      </.user_menu>
      <.link :if={!@current_user} href={~p"/sign-in"} class="btn btn-ghost btn-sm">Sign in</.link>
      <.link :if={!@current_user} href={~p"/register"} class="btn btn-primary btn-sm">
        Register
      </.link>
    </:topbar>

    {render_slot(@inner_block)}
  </.app_shell>

  <.flash_group flash={@flash} />
  """
end

# The UI kit gallery is mounted with the dev routes only, so it is linked only then.
defp dev_routes?, do: Application.get_env(:<%= @app %>, :dev_routes, false)

# The browser tab (`<.live_title>` in root.html.heex): `<page> · <name>`, and the
# tagline on a page without a title.
defp tab_default, do: <%= inspect(@prefix) %>.Concept.tagline()
defp tab_suffix, do: " · " <> <%= inspect(@prefix) %>.Concept.name()

@doc """
Shows the flash group with standard titles and content.

## Examples

    <.flash_group flash={@flash} />
"""
attr :flash, :map, required: true, doc: "the map of flash messages"
attr :id, :string, default: "flash-group", doc: "the optional id of flash container"

def flash_group(assigns) do
  ~H"""
  <div id={@id} aria-live="polite">
    <.flash kind={:info} flash={@flash} />
    <.flash kind={:error} flash={@flash} />

    <.flash
      id="client-error"
      kind={:error}
      title={gettext("We can't find the internet")}
      phx-disconnected={
        show(".phx-client-error #client-error")
        |> JS.remove_attribute("hidden", to: ".phx-client-error #client-error")
      }
      phx-connected={hide("#client-error") |> JS.set_attribute({"hidden", ""})}
      hidden
    >
      {gettext("Attempting to reconnect")}
      <.icon name="hero-arrow-path" class="ml-1 size-3 motion-safe:animate-spin" />
    </.flash>

    <.flash
      id="server-error"
      kind={:error}
      title={gettext("Something went wrong!")}
      phx-disconnected={
        show(".phx-server-error #server-error")
        |> JS.remove_attribute("hidden", to: ".phx-server-error #server-error")
      }
      phx-connected={hide("#server-error") |> JS.set_attribute({"hidden", ""})}
      hidden
    >
      {gettext("Attempting to reconnect")}
      <.icon name="hero-arrow-path" class="ml-1 size-3 motion-safe:animate-spin" />
    </.flash>
  </div>
  """
end

@doc """
Provides dark vs light theme toggle based on themes defined in app.css.

See <head> in root.html.heex which applies the theme before page load.
"""
def theme_toggle(assigns) do
  ~H"""
  <div class="card relative flex flex-row items-center border-2 border-base-300 bg-base-300 rounded-full">
    <div class="absolute w-1/3 h-full rounded-full border-1 border-base-200 bg-base-100 brightness-200 left-0 [[data-theme=light]_&]:left-1/3 [[data-theme=dark]_&]:left-2/3 [[data-theme-source=system]_&]:!left-0 transition-[left]" />

    <button
      class="flex p-2 cursor-pointer w-1/3"
      phx-click={JS.dispatch("phx:set-theme")}
      data-phx-theme="system"
      aria-label="Use the system theme"
    >
      <.icon name="hero-computer-desktop-micro" class="size-4 opacity-75 hover:opacity-100" />
    </button>

    <button
      class="flex p-2 cursor-pointer w-1/3"
      phx-click={JS.dispatch("phx:set-theme")}
      data-phx-theme="light"
      aria-label="Use the light theme"
    >
      <.icon name="hero-sun-micro" class="size-4 opacity-75 hover:opacity-100" />
    </button>

    <button
      class="flex p-2 cursor-pointer w-1/3"
      phx-click={JS.dispatch("phx:set-theme")}
      data-phx-theme="dark"
      aria-label="Use the dark theme"
    >
      <.icon name="hero-moon-micro" class="size-4 opacity-75 hover:opacity-100" />
    </button>
  </div>
  """
end
