<Layouts.app flash={@flash} current_user={assigns[:current_user]}>
  <section class="py-12 text-center sm:py-20">
    <h1 class="font-display text-5xl font-semibold tracking-tight"><%= inspect(@prefix) %></h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-base-content/70">
      Organizations, teammates and billing, ready to build on.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <.link :if={assigns[:current_user]} navigate={~p"/dashboard"} class="btn btn-primary">
        Go to dashboard <.icon name="hero-arrow-right-micro" class="size-4" />
      </.link>
      <.link :if={!assigns[:current_user]} href={~p"/sign-in"} class="btn btn-primary">
        Sign in
      </.link>
      <.link :if={!assigns[:current_user]} href={~p"/register"} class="btn btn-ghost">
        Create an account
      </.link>
    </div>
  </section>

  <div class="grid gap-4 sm:grid-cols-3">
    <.card>
      <.icon name="hero-building-office-2" class="size-6 text-primary" />
      <h2 class="mt-3 font-semibold">Organizations</h2>
      <p class="mt-1 text-sm text-base-content/70">
        Invite your team, give each person a role and switch between organizations.
      </p>
    </.card>
    <.card>
      <.icon name="hero-credit-card" class="size-6 text-primary" />
      <h2 class="mt-3 font-semibold">Billing</h2>
      <p class="mt-1 text-sm text-base-content/70">
        Stripe subscriptions with checkout and a self-service billing portal.
      </p>
    </.card>
    <.card>
      <.icon name="hero-bell" class="size-6 text-primary" />
      <h2 class="mt-3 font-semibold">Notifications</h2>
      <p class="mt-1 text-sm text-base-content/70">
        An in-app inbox and email, with per-person settings for each kind of message.
      </p>
    </.card>
  </div>
</Layouts.app>
