<Layouts.app flash={@flash} current_user={assigns[:current_user]}>
  <section class="py-12 text-center sm:py-20">
    <h1 class="font-display text-5xl font-semibold tracking-tight">
      {@concept.name}
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-base-content/70">
      {@concept.tagline}
    </p>
    <p
      :if={@concept.description != ""}
      class="mx-auto mt-4 max-w-2xl text-base-content/70"
    >
      {@concept.description}
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <.link :if={assigns[:current_user]} navigate={~p"/dashboard"} class="btn btn-primary">
        Go to dashboard <.icon name="hero-arrow-right-micro" class="size-4" />
      </.link>
      <form
        :if={!assigns[:current_user] && @concept.cta == :waitlist}
        id="waitlist-form"
        action={~p"/waitlist"}
        method="post"
        class="flex w-full max-w-md flex-col gap-2 sm:flex-row"
      >
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <input type="hidden" name="signup[source]" value={assigns[:utm][:source]} />
        <input type="hidden" name="signup[medium]" value={assigns[:utm][:medium]} />
        <input type="hidden" name="signup[campaign]" value={assigns[:utm][:campaign]} />
        <input type="hidden" name="signup[referrer]" value={assigns[:referrer]} />
        <label for="waitlist-email" class="sr-only">Email address</label>
        <input
          id="waitlist-email"
          type="email"
          name="signup[email]"
          placeholder="you@company.com"
          autocomplete="email"
          required
          class="input w-full"
        />
        <button type="submit" class="btn btn-primary">Join the waitlist</button>
      </form>
      <.link
        :if={!assigns[:current_user] && @concept.cta == :waitlist}
        href={~p"/sign-in"}
        class="btn btn-ghost"
      >
        Sign in
      </.link>
      <.link
        :if={!assigns[:current_user] && @concept.cta == :register}
        href={~p"/sign-in"}
        class="btn btn-primary"
      >
        Sign in
      </.link>
      <.link
        :if={!assigns[:current_user] && @concept.cta == :register}
        href={~p"/register"}
        class="btn btn-ghost"
      >
        Create an account
      </.link>
    </div>
  </section>

  <div class="grid gap-4 sm:grid-cols-3">
    <.card :for={prop <- @concept.value_props}>
      <.icon :if={prop[:icon]} name={prop.icon} class="size-6 text-primary" />
      <h2 class="mt-3 font-semibold">{prop.title}</h2>
      <p class="mt-1 text-sm text-base-content/70">{prop.body}</p>
    </.card>
  </div>

  <section :if={@concept.plans != []} id="pricing" class="mt-16">
    <h2 class="text-center font-display text-3xl font-semibold tracking-tight">Pricing</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <.card :for={plan <- @concept.plans} id={"plan-#{plan.key}"}>
        <h3 class="font-semibold">{plan.name}</h3>
        <p class="mt-2 text-3xl font-semibold tracking-tight">{plan.price}</p>
        <p :if={plan[:description] not in [nil, ""]} class="mt-2 text-sm text-base-content/70">
          {plan.description}
        </p>
        <ul class="mt-4 space-y-2 text-sm">
          <li :for={feature <- plan[:features] || []} class="flex items-center gap-2">
            <.icon name="hero-check-micro" class="size-4 text-success" /> {feature}
          </li>
        </ul>
        <.link
          href={
            cond do
              assigns[:current_user] -> ~p"/billing"
              @concept.cta == :waitlist -> "#waitlist-form"
              true -> ~p"/register"
            end
          }
          class="btn btn-primary mt-6 w-full"
        >
          Get started
        </.link>
      </.card>
    </div>
  </section>
</Layouts.app>
