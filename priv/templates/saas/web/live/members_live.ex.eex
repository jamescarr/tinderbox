@moduledoc """
The people in the current organization: change their role, remove them, and
invite new ones by email. Owners and admins manage; members see the list.

Every change goes through the Ash actions with the signed-in user as the actor,
so what the policies forbid (for example demoting the last owner) surfaces as a
flash message rather than being re-checked here.
"""

use <%= inspect(@web) %>, :live_view

import <%= inspect(@web) %>.LiveHelpers

require Ash.Query

alias <%= inspect(@accounts) %>.Invitation
alias <%= inspect(@accounts) %>.Membership

on_mount {<%= inspect(@web) %>.LiveUserAuth, :live_user_required}
on_mount {<%= inspect(@web) %>.LiveNotifications, :unread_count}
on_mount {<%= inspect(@web) %>.LiveOrganization, :require_organization}

@roles ~w(owner admin member)

@impl true
def mount(_params, _session, socket) do
  {:ok,
   socket
   |> assign(:page_title, "Members")
   |> assign(:roles, @roles)
   |> assign(:manager?, manager?(socket.assigns.current_membership))
   |> load()
   |> assign_invite_form()}
end

@impl true
def handle_event("validate_invite", %{"invitation" => params}, socket) do
  {:noreply, assign(socket, :invite_form, AshPhoenix.Form.validate(socket.assigns.invite_form, params))}
end

def handle_event("invite", %{"invitation" => params}, socket) do
  case AshPhoenix.Form.submit(socket.assigns.invite_form, params: params) do
    {:ok, invitation} ->
      {:noreply,
       socket
       |> put_flash(:info, "Invitation sent to #{invitation.email}")
       |> load()
       |> assign_invite_form()}

    {:error, form} ->
      {:noreply, assign(socket, :invite_form, form)}
  end
end

def handle_event("change_role", %{"membership_id" => id, "role" => role}, socket) when role in @roles do
  user = socket.assigns.current_user

  result =
    with {:ok, membership} <- find(Membership, id, socket) do
      Ash.update(membership, %{role: role}, action: :change_role, actor: user)
    end

  {:noreply, result |> report(socket, "Role updated") |> load()}
end

def handle_event("remove", %{"id" => id}, socket) do
  user = socket.assigns.current_user

  result =
    with {:ok, membership} <- find(Membership, id, socket) do
      Ash.destroy(membership, actor: user)
    end

  {:noreply, result |> report(socket, "Member removed") |> load()}
end

def handle_event("revoke", %{"id" => id}, socket) do
  user = socket.assigns.current_user

  result =
    with {:ok, invitation} <- find(Invitation, id, socket) do
      Ash.destroy(invitation, actor: user)
    end

  {:noreply, result |> report(socket, "Invitation revoked") |> load()}
end

@impl true
def handle_info(_message, socket), do: {:noreply, socket}

defp load(socket) do
  %{current_user: user, current_organization: organization} = socket.assigns

  memberships =
    Membership
    |> Ash.Query.filter(organization_id == ^organization.id)
    |> Ash.Query.load(:user)
    |> Ash.Query.sort(:inserted_at)
    |> Ash.read!(actor: user)

  # Members cannot read invitations (the policy lets owners and admins only).
  invitations =
    Invitation
    |> Ash.Query.filter(organization_id == ^organization.id and is_nil(accepted_at))
    |> Ash.Query.sort(:inserted_at)
    |> Ash.read!(actor: user)

  assign(socket, memberships: memberships, invitations: invitations)
end

defp assign_invite_form(socket) do
  %{current_user: user, current_organization: organization} = socket.assigns

  form =
    Invitation
    |> AshPhoenix.Form.for_create(:invite,
      actor: user,
      as: "invitation",
      params: %{"organization_id" => organization.id, "role" => "member"}
    )
    |> to_form()

  assign(socket, :invite_form, form)
end

@impl true
def render(assigns) do
  ~H"""
  <Layouts.app
    flash={@flash}
    current_user={@current_user}
    current_organization={@current_organization}
    organizations={@organizations}
    unread_count={@unread_count}
    current_page={:members}
  >
    <.page_header>
      Members
      <:subtitle>
        {length(@memberships)} {if length(@memberships) == 1, do: "person", else: "people"} in {@current_organization.name}
      </:subtitle>
    </.page_header>

    <div class="space-y-6">
      <.card padded={false}>
        <:title>People</:title>
        <div class="overflow-x-auto">
          <table class="table" id="memberships">
            <thead class="bg-base-200/60 text-xs tracking-wide text-base-content/60 uppercase">
              <tr>
                <th scope="col">Email</th>
                <th scope="col">Role</th>
                <th :if={@manager?} scope="col"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <tr :for={membership <- @memberships} id={"membership-#{membership.id}"}>
                <td>
                  <div class="flex items-center gap-3">
                    <.avatar name={to_string(membership.user.email)} />
                    <span class="font-medium">{to_string(membership.user.email)}</span>
                  </div>
                </td>
                <td>
                  <form :if={@manager?} id={"role-form-#{membership.id}"} phx-change="change_role">
                    <input type="hidden" name="membership_id" value={membership.id} />
                    <select name="role" class="select select-sm w-36" aria-label="Role">
                      <option
                        :for={role <- @roles}
                        value={role}
                        selected={role == to_string(membership.role)}
                      >
                        {role}
                      </option>
                    </select>
                  </form>
                  <.badge :if={!@manager?}>{membership.role}</.badge>
                </td>
                <td :if={@manager?} class="text-right">
                  <.button
                    class="btn btn-ghost btn-sm text-error"
                    phx-click="remove"
                    phx-value-id={membership.id}
                    data-confirm={"Remove #{membership.user.email} from #{@current_organization.name}?"}
                  >
                    Remove
                  </.button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </.card>

      <.card :if={@manager?} padded={@invitations == []}>
        <:title>Pending invitations</:title>
        <table :if={@invitations != []} class="table" id="invitations">
          <tbody>
            <tr :for={invitation <- @invitations} id={"invitation-#{invitation.id}"}>
              <td>
                <div class="flex items-center gap-3">
                  <.avatar name={to_string(invitation.email)} />
                  {to_string(invitation.email)}
                </div>
              </td>
              <td><.badge>{invitation.role}</.badge></td>
              <td class="text-right">
                <button
                  type="button"
                  class="btn btn-ghost btn-sm"
                  phx-click="revoke"
                  phx-value-id={invitation.id}
                >
                  Revoke
                </button>
              </td>
            </tr>
          </tbody>
        </table>
        <.empty_state
          :if={@invitations == []}
          icon="hero-envelope"
          title="No pending invitations"
        >
          Invite someone below; they show up here until they accept.
        </.empty_state>
      </.card>

      <.card :if={@manager?}>
        <:title>Invite someone</:title>
        <:description>They get an email with a link to join {@current_organization.name}.</:description>
        <.form for={@invite_form} id="invite-form" phx-change="validate_invite" phx-submit="invite">
          <.input field={@invite_form[:organization_id]} type="hidden" />
          <div class="grid gap-x-4 sm:grid-cols-3">
            <div class="sm:col-span-2">
              <.input field={@invite_form[:email]} type="email" label="Email" required />
            </div>
            <.input field={@invite_form[:role]} type="select" label="Role" options={@roles} />
          </div>
          <div class="mt-2 flex justify-end">
            <.button variant="primary" phx-disable-with="Inviting...">Send invitation</.button>
          </div>
        </.form>
      </.card>
    </div>
  </Layouts.app>
  """
end
