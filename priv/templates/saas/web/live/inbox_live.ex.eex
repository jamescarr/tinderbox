@moduledoc """
The user's notification inbox.

New notifications appear without a reload: this view and
`<%= inspect(@web) %>.LiveNotifications` both listen on the user's `notifications:<user id>` topic.
"""

use <%= inspect(@web) %>, :live_view

alias <%= inspect(@prefix) %>.Notifications

on_mount {<%= inspect(@web) %>.LiveUserAuth, :live_user_required}
on_mount {<%= inspect(@web) %>.LiveNotifications, :unread_count}
on_mount {<%= inspect(@web) %>.LiveOrganization, :optional_organization}

@impl true
def mount(_params, _session, socket) do
  {:ok,
   socket
   |> assign(:page_title, "Inbox")
   |> assign(:notifications, Notifications.feed(socket.assigns.current_user))}
end

@impl true
def handle_event("mark_read", %{"id" => id}, socket) do
  Notifications.mark_read(socket.assigns.current_user, id)
  {:noreply, reload(socket)}
end

def handle_event("archive", %{"id" => id}, socket) do
  Notifications.archive(socket.assigns.current_user, id)
  {:noreply, reload(socket)}
end

def handle_event("mark_all_read", _params, socket) do
  Notifications.mark_all_read(socket.assigns.current_user)
  {:noreply, reload(socket)}
end

# `LiveNotifications` has already bumped the unread count; the row is added here.
@impl true
def handle_info({:notification_created, notification}, socket) do
  {:noreply, update(socket, :notifications, &[notification | &1])}
end

def handle_info(_message, socket), do: {:noreply, socket}

defp reload(socket) do
  user = socket.assigns.current_user

  socket
  |> assign(:notifications, Notifications.feed(user))
  |> assign(:unread_count, Notifications.unread_count(user))
end

@impl true
def render(assigns) do
  ~H"""
  <Layouts.app
    flash={@flash}
    current_user={@current_user}
    current_organization={@current_organization}
    organizations={@organizations}
    unread_count={@unread_count}
    current_page={:inbox}
  >
    <.page_header>
      Inbox
      <:subtitle>
        {if @unread_count > 0, do: "#{@unread_count} unread", else: "Everything is read"}
      </:subtitle>
      <:actions>
        <button
          :if={@unread_count > 0}
          type="button"
          class="btn btn-ghost btn-sm"
          phx-click="mark_all_read"
        >
          <.icon name="hero-check-micro" class="size-4" /> Mark all read
        </button>
      </:actions>
    </.page_header>

    <.card padded={false}>
      <ul :if={@notifications != []} id="notifications" class="divide-y divide-base-300">
        <li
          :for={notification <- @notifications}
          id={"notification-#{notification.id}"}
          class={[
            "flex items-start gap-4 px-5 py-4",
            is_nil(notification.read_at) && "bg-primary/5"
          ]}
        >
          <span
            class={[
              "mt-2 size-2 shrink-0 rounded-full",
              if(is_nil(notification.read_at), do: "bg-primary", else: "bg-transparent")
            ]}
            aria-hidden="true"
          />
          <div class="min-w-0 flex-1 space-y-1">
            <div class="flex items-baseline justify-between gap-3">
              <p class="font-medium">
                <span :if={is_nil(notification.read_at)} class="sr-only">Unread:</span>
                {notification.title}
              </p>
              <time class="shrink-0 text-xs text-base-content/60">
                {relative_time(notification.inserted_at)}
              </time>
            </div>
            <p :if={notification.body} class="text-sm text-base-content/70">{notification.body}</p>
            <div class="flex flex-wrap items-center gap-1 pt-1">
              <.link
                :if={notification.url}
                navigate={notification.url}
                class="btn btn-ghost btn-xs text-primary"
              >
                Open
              </.link>
              <button
                :if={is_nil(notification.read_at)}
                type="button"
                class="btn btn-ghost btn-xs"
                phx-click="mark_read"
                phx-value-id={notification.id}
              >
                Mark read
              </button>
              <button
                type="button"
                class="btn btn-ghost btn-xs"
                phx-click="archive"
                phx-value-id={notification.id}
              >
                Archive
              </button>
            </div>
          </div>
        </li>
      </ul>
      <div :if={@notifications == []} class="p-5">
        <.empty_state icon="hero-inbox" title="You're all caught up">
          New notifications appear here as they arrive.
        </.empty_state>
      </div>
    </.card>
  </Layouts.app>
  """
end
