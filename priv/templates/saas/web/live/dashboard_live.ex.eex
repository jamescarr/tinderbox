@moduledoc """
The signed-in landing page: the current organization at a glance.
"""

use <%= inspect(@web) %>, :live_view

require Ash.Query

alias <%= inspect(@accounts) %>.Membership
alias <%= inspect(@prefix) %>.Notifications

on_mount {<%= inspect(@web) %>.LiveUserAuth, :live_user_required}
on_mount {<%= inspect(@web) %>.LiveNotifications, :unread_count}
on_mount {<%= inspect(@web) %>.LiveOrganization, :require_organization}

@impl true
def mount(_params, _session, socket) do
  {:ok, socket |> assign(:page_title, "Dashboard") |> load()}
end

@impl true
def handle_info({:notification_created, _notification}, socket) do
  {:noreply, load(socket)}
end

def handle_info(_message, socket), do: {:noreply, socket}

defp load(socket) do
  %{current_user: user, current_organization: organization} = socket.assigns

  member_count =
    Membership
    |> Ash.Query.filter(organization_id == ^organization.id)
    |> Ash.count!(actor: user)

  assign(socket,
    member_count: member_count,
    notifications: Notifications.feed(user, limit: 5)
  )
end

@impl true
def render(assigns) do
  ~H"""
  <Layouts.app
    flash={@flash}
    current_user={@current_user}
    current_organization={@current_organization}
    organizations={@organizations}
    unread_count={@unread_count}
    current_page={:dashboard}
  >
    <.page_header>
      {@current_organization.name}
      <:subtitle>
        Your role <.badge class="ml-1">{@current_membership.role}</.badge>
      </:subtitle>
    </.page_header>

    <div class="space-y-6">
      <.stat_grid>
        <:stat
          label="Members"
          value={@member_count}
          icon="hero-users"
          hint="Manage members"
          navigate={~p"/organizations/members"}
        />
        <:stat
          :if={@current_organization.subscription}
          label="Plan"
          value={@current_organization.subscription.plan_key || "Custom"}
          icon="hero-credit-card"
          navigate={~p"/billing"}
        >
          <.status_badge status={@current_organization.subscription.status} />
        </:stat>
        <:stat
          :if={!@current_organization.subscription}
          label="Plan"
          value="None"
          icon="hero-credit-card"
          hint="Choose a plan"
          navigate={~p"/billing"}
        />
        <:stat label="Unread" value={@unread_count} icon="hero-inbox" navigate={~p"/inbox"} />
      </.stat_grid>

      <.card>
        <:title>Recent notifications</:title>
        <.feed :if={@notifications != []} id="recent-notifications">
          <:item
            :for={notification <- @notifications}
            title={notification.title}
            time={notification.inserted_at}
            unread={is_nil(notification.read_at)}
          >
            {notification.body}
          </:item>
        </.feed>
        <.empty_state :if={@notifications == []} icon="hero-bell" title="Nothing yet">
          Invitations, billing changes and mentions show up here.
        </.empty_state>
        <:footer>
          <.link navigate={~p"/inbox"} class="link link-primary link-hover">Open inbox</.link>
        </:footer>
      </.card>
    </div>
  </Layouts.app>
  """
end
