@moduledoc """
Accepting an invitation: `/invitations/:token`, linked from the invitation email
and notification.

The invitee has to be signed in as the invited address (the `:accept` action
checks it). A token that is unknown, already used or expired sends the visitor
home with an error.
"""

use <%= inspect(@web) %>, :live_view

import <%= inspect(@web) %>.LiveHelpers, only: [error_message: 1]

alias <%= inspect(@accounts) %>.Invitation

on_mount {<%= inspect(@web) %>.LiveUserAuth, :live_user_required}
on_mount {<%= inspect(@web) %>.LiveNotifications, :unread_count}

@impl true
def mount(%{"token" => token}, _session, socket) do
  user = socket.assigns.current_user

  with {:ok, %Invitation{} = invitation} <-
         Invitation
         |> Ash.Query.for_read(:by_token, %{token: token}, actor: user)
         |> Ash.read_one(),
       # The invitee is not a member yet, so the organization is read without
       # the actor: holding the token is what authorizes seeing its name.
       {:ok, invitation} <- Ash.load(invitation, :organization, authorize?: false) do
    {:ok, socket |> assign(:page_title, "Invitation") |> assign(:invitation, invitation)}
  else
    _invalid_or_expired ->
      {:ok,
       socket
       |> put_flash(:error, "This invitation is invalid or has expired")
       |> push_navigate(to: ~p"/")}
  end
end

@impl true
def handle_event("accept", _params, socket) do
  %{current_user: user, invitation: invitation} = socket.assigns

  case Ash.update(invitation, %{}, action: :accept, actor: user) do
    {:ok, _invitation} ->
      {:noreply,
       socket
       |> put_flash(:info, "Welcome to #{invitation.organization.name}")
       |> push_navigate(to: ~p"/dashboard")}

    {:error, error} ->
      {:noreply, put_flash(socket, :error, error_message(error))}
  end
end

@impl true
def handle_info(_message, socket), do: {:noreply, socket}

@impl true
def render(assigns) do
  ~H"""
  <Layouts.app flash={@flash} current_user={@current_user} unread_count={@unread_count}>
    <.card class="mx-auto mt-8 max-w-md">
      <div class="flex flex-col items-center py-4 text-center">
        <.avatar name={@invitation.organization.name} size="lg" />
        <h1 class="mt-4 font-display text-2xl font-semibold tracking-tight">
          Join {@invitation.organization.name}
        </h1>
        <p class="mt-2 text-sm text-base-content/70">
          {to_string(@invitation.email)} was invited as <.badge>{@invitation.role}</.badge>
        </p>
        <.button variant="primary" class="btn btn-primary mt-6 w-full" phx-click="accept">
          Accept invitation
        </.button>
      </div>
    </.card>
  </Layouts.app>
  """
end
