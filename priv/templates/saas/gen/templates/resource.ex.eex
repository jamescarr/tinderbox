@moduledoc """
<%= @human_plural %> of an organization. Owners and admins create, update and destroy
them; members read them<%= if @admin_bypass?, do: "; platform admins do anything", else: "" %>.

Generated by `mix <%= @app %>.gen.resource`; it is this application's code now.
"""

use Ash.Resource,
  otp_app: <%= inspect(@app) %>,
  domain: <%= inspect(@domain) %>,
  data_layer: AshPostgres.DataLayer,
  authorizers: [Ash.Policy.Authorizer],
  notifiers: [<%= inspect(@prefix) %>.Events.AshNotifier]

postgres do
  table <%= inspect(@table) %>
  repo <%= inspect(@repo) %>

  references do
    reference :organization, on_delete: :delete
<%= for relation <- @belongs_to do %>    reference <%= inspect(relation.name) %>, on_delete: <%= if relation.required?, do: ":delete", else: ":nilify" %>
<% end %>  end
end

actions do
  defaults [:read, :destroy]

  create :create do
    primary? true
    accept <%= inspect([:organization_id | Enum.map(@attributes, & &1.field)]) %>

    change {<%= inspect(@prefix) %>.Analytics.Changes.Track, event: <%= inspect(@singular <> ".created") %>}
<%= if @same_organization != [] do %>
    validate {<%= inspect(@accounts) %>.Validations.SameOrganization,
              fields: <%= inspect(@same_organization) %>}
<% end %>  end

  update :update do
    primary? true
    require_atomic? false
    accept <%= inspect(Enum.map(@attributes, & &1.field)) %>
<%= if @same_organization != [] do %>
    validate {<%= inspect(@accounts) %>.Validations.SameOrganization,
              fields: <%= inspect(@same_organization) %>}
<% end %>  end
end

policies do
<%= if @admin_bypass? do %>  bypass actor_attribute_equals(:role, :admin) do
    authorize_if always()
  end

<% end %>  policy action_type(:read) do
    authorize_if expr(exists(organization.memberships, user_id == ^actor(:id)))
  end

  policy action_type([:create, :update, :destroy]) do
    authorize_if {<%= inspect(@accounts) %>.Checks.ActorManagesOrganization, field: :organization_id}
  end
end

attributes do
  uuid_primary_key :id
<%= for attribute <- @scalars do %>
  attribute <%= inspect(attribute.name) %>, <%= inspect(attribute.ash_type) %><%= for {key, value} <- attribute.options do %>, <%= key %>: <%= inspect(value) %><% end %>
<% end %>
  create_timestamp :inserted_at
  update_timestamp :updated_at
end

relationships do
  belongs_to :organization, <%= inspect(@accounts) %>.Organization, allow_nil?: false, public?: true
<%= for relation <- @belongs_to do %>
  belongs_to <%= inspect(relation.name) %>, <%= inspect(relation.target) %><%= if relation.required?, do: ", allow_nil?: false" %>, public?: true
<% end %>end
<%= if @unique != [] do %>
identities do
<%= for attribute <- @unique do %>  identity :unique_<%= attribute.name %>, [:organization_id, <%= inspect(attribute.field) %>]
<% end %>end
<% end %>
