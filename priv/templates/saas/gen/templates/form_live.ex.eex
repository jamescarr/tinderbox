@moduledoc """
Adds a <%= String.downcase(@human_singular) %> to the current organization (`:new`) or edits one
(`:edit`). Owners and admins only: members are sent back to the dashboard.

Generated by `mix <%= @app %>.gen.live`; it is this application's code now.
"""

use <%= inspect(@web) %>, :live_view

import <%= inspect(@web) %>.LiveHelpers
<%= if @belongs_to != [] do %>
require Ash.Query
<% end %>
alias <%= inspect(@resource) %>

on_mount {<%= inspect(@web) %>.LiveUserAuth, :live_user_required}
on_mount {<%= inspect(@web) %>.LiveNotifications, :unread_count}
on_mount {<%= inspect(@web) %>.LiveOrganization, :require_manager}

@impl true
def mount(_params, _session, socket) do
  {:ok,
   socket<%= if @belongs_to != [] do %>
   |> assign_options()<% end %><%= for file <- @files do %>
   |> allow_upload(<%= inspect(file.name) %>, accept: :any, max_entries: 1, max_file_size: 10_000_000)<% end %>}
end

@impl true
def handle_params(params, _uri, socket) do
  {:noreply, apply_action(socket, socket.assigns.live_action, params)}
end

defp apply_action(socket, :new, _params) do
  %{current_user: user, current_organization: organization} = socket.assigns

  form =
    <%= @alias %>
    |> AshPhoenix.Form.for_create(:create,
      actor: user,
      as: <%= inspect(@singular) %>,
      params: %{"organization_id" => organization.id<%= for {name, expression} <- @seeded do %>, <%= inspect(to_string(name)) %> => <%= expression %><% end %>}
    )
    |> to_form()

  assign(socket, page_title: <%= inspect("New " <> String.downcase(@human_singular)) %>, <%= @singular %>: nil, form: form)
end

defp apply_action(socket, :edit, %{"id" => id}) do
  case find(<%= @alias %>, id, socket) do
    {:ok, <%= @singular %>} ->
      form =
        <%= @singular %>
        |> AshPhoenix.Form.for_update(:update, actor: socket.assigns.current_user, as: <%= inspect(@singular) %>)
        |> to_form()

      assign(socket, page_title: "Edit #{display_name(<%= @singular %>)}", <%= @singular %>: <%= @singular %>, form: form)

    {:error, _error} ->
      socket
      |> put_flash(:error, <%= inspect(@human_singular <> " not found") %>)
      |> push_navigate(to: ~p"/<%= @route %>")
  end
end

@impl true
def handle_event("validate", %{<%= inspect(@singular) %> => params}, socket) do
  {:noreply, assign(socket, :form, AshPhoenix.Form.validate(socket.assigns.form, params))}
end
<%= if @files == [] do %>
def handle_event("save", %{<%= inspect(@singular) %> => params}, socket) do
  case AshPhoenix.Form.submit(socket.assigns.form, params: params) do
    {:ok, <%= @singular %>} ->
      {:noreply,
       socket
       |> put_flash(:info, <%= inspect(@human_singular <> " saved") %>)
       |> push_navigate(to: ~p"/<%= @route %>/#{<%= @singular %>.id}")}

    {:error, form} ->
      {:noreply, assign(socket, :form, form)}
  end
end
<% else %>
# A form with nothing but file inputs posts no <%= inspect(@singular) %> params at all.
def handle_event("validate", _params, socket), do: {:noreply, socket}

def handle_event("save", params, socket) do
  # The files come from the uploads, never from what the browser posts for them.
  params = params |> Map.get(<%= inspect(@singular) %>, %{}) |> Map.drop(<%= inspect(Enum.map(@files, &to_string(&1.name))) %>)

  with {:ok, files} <- consume_files(socket),
       {:ok, <%= @singular %>} <-
         AshPhoenix.Form.submit(socket.assigns.form, params: Map.merge(params, files)) do
    {:noreply,
     socket
     |> put_flash(:info, <%= inspect(@human_singular <> " saved") %>)
     |> push_navigate(to: ~p"/<%= @route %>/#{<%= @singular %>.id}")}
  else
    {:error, {:storage, _reason}} ->
      {:noreply, put_flash(socket, :error, "The file could not be stored, try again")}

    {:error, form} ->
      {:noreply, assign(socket, :form, form)}
  end
end
<%= for file <- @files do %>
def handle_event("cancel-upload", %{"upload" => <%= inspect(to_string(file.name)) %>, "ref" => ref}, socket) do
  {:noreply, cancel_upload(socket, <%= inspect(file.name) %>, ref)}
end
<% end %><% end %>

@impl true
def handle_info(_message, socket), do: {:noreply, socket}
<%= if @files != [] do %>
defp upload_error(:too_large), do: "The file is too large (10 MB at most)"
defp upload_error(:too_many_files), do: "Choose one file"
defp upload_error(_error), do: "The file cannot be uploaded"

# Stores what was uploaded under the organization's id, where
# `<%= inspect(@web) %>.FileController` looks for it, and returns the params that
# describe the files. A file field with nothing uploaded is left out of them, so an
# edit keeps the file it has. An upload is consumed even when the form then fails
# validation: the file has to be chosen again, and the stored object stays behind.
defp consume_files(socket) do
  organization = socket.assigns.current_organization

  Enum.reduce_while(<%= inspect(Enum.map(@files, & &1.name)) %>, {:ok, %{}}, fn name, {:ok, files} ->
    case consume_uploaded_entries(socket, name, &store_file(&1, &2, organization)) do
      [] -> {:cont, {:ok, files}}
      [{:ok, file}] -> {:cont, {:ok, Map.put(files, to_string(name), file)}}
      [{:error, reason}] -> {:halt, {:error, {:storage, reason}}}
    end
  end)
end

defp store_file(%{path: path}, entry, organization) do
  key = "#{organization.id}/<%= @table %>/#{Ash.UUID.generate()}/#{Path.basename(entry.client_name)}"

  result =
    case <%= inspect(@prefix) %>.Storage.put(key, File.read!(path)) do
      :ok ->
        {:ok,
         %{
           "key" => key,
           "filename" => Path.basename(entry.client_name),
           "content_type" => entry.client_type,
           "size" => entry.client_size
         }}

      {:error, reason} ->
        {:error, reason}
    end

  {:ok, result}
end
<% end %>
<%= if @belongs_to != [] do %>
# The choices for each `belongs_to`, from the current organization: at most 1000
# of them (a longer list wants a search box, not a select).
defp assign_options(socket) do
  %{current_user: user, current_organization: organization} = socket.assigns

  socket<%= for relation <- @belongs_to do %>
  |> assign(<%= inspect(:"#{relation.name}_options") %>, <%= cond do %><% relation.target == @user -> %>
    <%= inspect(@accounts) %>.Membership
    |> Ash.Query.filter(organization_id == ^organization.id)
    |> Ash.Query.load(:user)
    |> Ash.Query.limit(1000)
    |> Ash.read!(actor: user)
    |> Enum.map(&{to_string(&1.user.email), &1.user_id})<% relation.target == Module.concat(@accounts, "Organization") -> %>
    Enum.map(socket.assigns.organizations, &{&1.name, &1.id})<% true -> %>
    <%= inspect(relation.target) %>
    |> Ash.Query.filter(organization_id == ^organization.id)
    |> Ash.Query.sort(inserted_at: :desc)
    |> Ash.Query.limit(1000)
    |> Ash.read!(actor: user)
    |> Enum.map(&{display_name(&1), &1.id})<% end %>
  )<% end %>
end
<% end %>
@impl true
def render(assigns) do
  ~H"""
  <Layouts.app
    flash={@flash}
    current_user={@current_user}
    current_organization={@current_organization}
    organizations={@organizations}
    unread_count={@unread_count}
    current_page={:<%= @plural %>}
  >
    <.page_header>
      {@page_title}
      <:breadcrumb navigate={~p"/<%= @route %>"}><%= @human_plural %></:breadcrumb>
      <:breadcrumb :if={@<%= @singular %>} navigate={~p"/<%= @route %>/#{@<%= @singular %>.id}"}>
        {display_name(@<%= @singular %>)}
      </:breadcrumb>
      <:breadcrumb>{if @<%= @singular %>, do: "Edit", else: "New"}</:breadcrumb>
    </.page_header>

    <.card>
      <.form for={@form} id="<%= @singular %>-form" phx-change="validate" phx-submit="save">
        <.input :if={!@<%= @singular %>} field={@form[:organization_id]} type="hidden" /><%= for attribute <- @attributes, attribute.input != :none do %>
        <%= case attribute.input do %><% :text -> %><.input field={@form[<%= inspect(attribute.field) %>]} type="text" label=<%= inspect(@gen.humanize(attribute.name)) %> /><% :textarea -> %><.input field={@form[<%= inspect(attribute.field) %>]} type="textarea" label=<%= inspect(@gen.humanize(attribute.name)) %> /><% :number -> %><.input field={@form[<%= inspect(attribute.field) %>]} type="number" label=<%= inspect(@gen.humanize(attribute.name)) %><%= if attribute.type == :decimal, do: ~s( step="0.01") %> /><% :checkbox -> %><.input field={@form[<%= inspect(attribute.field) %>]} type="checkbox" label=<%= inspect(@gen.humanize(attribute.name)) %> /><% :date -> %><.input field={@form[<%= inspect(attribute.field) %>]} type="date" label=<%= inspect(@gen.humanize(attribute.name)) %> /><% :datetime -> %><.input field={@form[<%= inspect(attribute.field) %>]} type="datetime-local" label=<%= inspect(@gen.humanize(attribute.name)) %> /><% :select -> %><.input
          field={@form[<%= inspect(attribute.field) %>]}
          type="select"
          label=<%= inspect(@gen.humanize(attribute.name)) %>
          options={enum_options(<%= inspect(attribute.values) %>)}
        /><% :file -> %><div class="fieldset mb-2">
          <label class="label mb-1" for={@uploads.<%= attribute.name %>.ref}><%= @gen.humanize(attribute.name) %></label>
          <.live_file_input upload={@uploads.<%= attribute.name %>} class="file-input w-full" />
          <p :if={@<%= @singular %> && @<%= @singular %>.<%= attribute.name %>} class="mt-1 text-sm text-base-content/70">
            Current file: <.file_link file={@<%= @singular %>.<%= attribute.name %>} />. Choose another to replace it.
          </p>
          <div :for={entry <- @uploads.<%= attribute.name %>.entries} class="mt-2 flex items-center gap-2 text-sm">
            <span class="truncate">{entry.client_name}</span>
            <progress class="progress progress-primary w-24" value={entry.progress} max="100">
              {entry.progress}%
            </progress>
            <button
              type="button"
              class="btn btn-ghost btn-xs"
              phx-click="cancel-upload"
              phx-value-upload=<%= inspect(to_string(attribute.name)) %>
              phx-value-ref={entry.ref}
              aria-label={"Cancel #{entry.client_name}"}
            >
              &times;
            </button>
            <span :for={error <- upload_errors(@uploads.<%= attribute.name %>, entry)} class="text-error">
              {upload_error(error)}
            </span>
          </div>
          <p :for={error <- upload_errors(@uploads.<%= attribute.name %>)} class="mt-1 text-sm text-error">
            {upload_error(error)}
          </p>
          <p :for={error <- @form[<%= inspect(attribute.field) %>].errors} class="mt-1 text-sm text-error">
            {translate_error(error)}
          </p>
        </div><% :relation -> %><.input
          field={@form[<%= inspect(attribute.field) %>]}
          type="select"
          label=<%= inspect(@gen.humanize(attribute.name)) %>
          options={@<%= attribute.name %>_options}<%= unless attribute.required? do %>
          prompt="Choose…"<% end %>
        /><% end %><% end %>
        <div class="mt-6 flex gap-2">
          <.button variant="primary" phx-disable-with="Saving…">Save</.button>
          <.link
            navigate={if @<%= @singular %>, do: ~p"/<%= @route %>/#{@<%= @singular %>.id}", else: ~p"/<%= @route %>"}
            class="btn btn-ghost"
          >
            Cancel
          </.link>
        </div>
      </.form>
    </.card>
  </Layouts.app>
  """
end
