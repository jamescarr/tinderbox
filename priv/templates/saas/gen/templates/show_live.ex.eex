@moduledoc """
One <%= String.downcase(@human_singular) %> of the current organization. Owners and admins edit or
delete it from here; a <%= String.downcase(@human_singular) %> the user may not read is "not found".

Generated by `mix <%= @app %>.gen.live`; it is this application's code now.
"""

use <%= inspect(@web) %>, :live_view

import <%= inspect(@web) %>.LiveHelpers

alias <%= inspect(@resource) %>

on_mount {<%= inspect(@web) %>.LiveUserAuth, :live_user_required}
on_mount {<%= inspect(@web) %>.LiveNotifications, :unread_count}
on_mount {<%= inspect(@web) %>.LiveOrganization, :require_organization}

@impl true
def mount(_params, _session, socket) do
  {:ok, assign(socket, :manager?, manager?(socket.assigns.current_membership))}
end

@impl true
def handle_params(%{"id" => id}, _uri, socket) do
  case find(<%= @alias %>, id, socket<%= if @belongs_to != [] do %>, load: <%= inspect(Enum.map(@belongs_to, & &1.name)) %><% end %>) do
    {:ok, <%= @singular %>} ->
      {:noreply, assign(socket, page_title: display_name(<%= @singular %>), <%= @singular %>: <%= @singular %>)}

    {:error, _error} ->
      {:noreply,
       socket
       |> put_flash(:error, <%= inspect(@human_singular <> " not found") %>)
       |> push_navigate(to: ~p"/<%= @route %>")}
  end
end

@impl true
def handle_event("delete", _params, socket) do
  case Ash.destroy(socket.assigns.<%= @singular %>, actor: socket.assigns.current_user) do
    :ok ->
      {:noreply,
       socket
       |> put_flash(:info, <%= inspect(@human_singular <> " deleted") %>)
       |> push_navigate(to: ~p"/<%= @route %>")}

    {:error, error} ->
      {:noreply, put_flash(socket, :error, error_message(error))}
  end
end

@impl true
def handle_info(_message, socket), do: {:noreply, socket}

@impl true
def render(assigns) do
  ~H"""
  <Layouts.app
    flash={@flash}
    current_user={@current_user}
    current_organization={@current_organization}
    organizations={@organizations}
    unread_count={@unread_count}
    current_page={:<%= @plural %>}
  >
    <.page_header>
      {display_name(@<%= @singular %>)}
      <:breadcrumb navigate={~p"/<%= @route %>"}><%= @human_plural %></:breadcrumb>
      <:breadcrumb>{display_name(@<%= @singular %>)}</:breadcrumb>
      <:actions :if={@manager?}>
        <.link
          id="edit-<%= @singular %>"
          navigate={~p"/<%= @route %>/#{@<%= @singular %>.id}/edit"}
          class="btn btn-sm"
        >
          Edit
        </.link>
        <.button
          id="delete-<%= @singular %>"
          class="btn btn-ghost btn-sm text-error"
          phx-click="delete"
          data-confirm={"Delete #{display_name(@<%= @singular %>)}?"}
        >
          Delete
        </.button>
      </:actions>
    </.page_header>

    <.card>
      <.description_list><%= for attribute <- @scalars do %>
        <:item label=<%= inspect(@gen.humanize(attribute.name)) %>>{format_value(@<%= @singular %>.<%= attribute.name %>)}</:item><% end %><%= for relation <- @belongs_to do %>
        <:item label=<%= inspect(@gen.humanize(relation.name)) %>>{display_name(@<%= @singular %>.<%= relation.name %>)}</:item><% end %>
        <:item label="Created">{format_datetime(@<%= @singular %>.inserted_at)}</:item>
        <:item label="Updated">{format_datetime(@<%= @singular %>.updated_at)}</:item>
      </.description_list>
    </.card>
  </Layouts.app>
  """
end
