@moduledoc """
The current organization's <%= String.downcase(@human_plural) %>, searchable and sortable. Owners and
admins add, edit and delete them; members read them.

Generated by `mix <%= @app %>.gen.live`; it is this application's code now.
"""

use <%= inspect(@web) %>, :live_view

import <%= inspect(@web) %>.LiveHelpers

require Ash.Query

alias <%= inspect(@resource) %>

on_mount {<%= inspect(@web) %>.LiveUserAuth, :live_user_required}
on_mount {<%= inspect(@web) %>.LiveNotifications, :unread_count}
on_mount {<%= inspect(@web) %>.LiveOrganization, :require_organization}

@impl true
def mount(_params, _session, socket) do
  state =
    ListState.new(
      search_fields: <%= inspect(@search_fields) %>,
      sortable: <%= inspect(@sortable) %>,
      sort_by: :inserted_at,
      sort_dir: :desc
    )

  {:ok,
   socket
   |> assign(:page_title, <%= inspect(@human_plural) %>)
   |> assign(:manager?, manager?(socket.assigns.current_membership))
   |> load()
   |> run(state)}
end

@impl true
def handle_event("table", params, socket) do
  {:noreply, run(socket, ListState.update(socket.assigns.table, params))}
end

def handle_event("delete", %{"id" => id}, socket) do
  result =
    with {:ok, <%= @singular %>} <- find(<%= @alias %>, id, socket) do
      Ash.destroy(<%= @singular %>, actor: socket.assigns.current_user)
    end

  {:noreply,
   result
   |> report(socket, <%= inspect(@human_singular <> " deleted") %>)
   |> load()
   |> run(socket.assigns.table)}
end

@impl true
def handle_info(_message, socket), do: {:noreply, socket}

defp load(socket) do
  %{current_user: user, current_organization: organization} = socket.assigns

  <%= @plural %> =
    <%= @alias %>
    |> Ash.Query.filter(organization_id == ^organization.id)
    |> Ash.Query.sort(inserted_at: :desc)<%= if @belongs_to != [] do %>
    |> Ash.Query.load(<%= inspect(Enum.map(@belongs_to, & &1.name)) %>)<% end %>
    |> Ash.read!(actor: user)

  assign(socket, :all_rows, <%= @plural %>)
end

defp run(socket, state) do
  {rows, state} = ListState.run(socket.assigns.all_rows, state)
  assign(socket, rows: rows, table: state)
end

@impl true
def render(assigns) do
  ~H"""
  <Layouts.app
    flash={@flash}
    current_user={@current_user}
    current_organization={@current_organization}
    organizations={@organizations}
    unread_count={@unread_count}
    current_page={:<%= @plural %>}
    wide
  >
    <.page_header>
      <%= @human_plural %>
      <:subtitle>In {@current_organization.name}</:subtitle>
      <:actions>
        <.link
          :if={@manager?}
          id="new-<%= @singular %>"
          navigate={~p"/<%= @route %>/new"}
          class="btn btn-primary btn-sm"
        >
          New <%= String.downcase(@human_singular) %>
        </.link>
      </:actions>
    </.page_header>

    <.data_table
      id="<%= @plural %>"
      rows={@rows}
      state={@table}<%= if @search_fields != [] do %>
      searchable<% end %>
      row_id={&"<%= @singular %>-#{&1.id}"}
      row_click={&JS.navigate(~p"/<%= @route %>/#{&1.id}")}
    ><%= for attribute <- @scalars do %>
      <:col :let={<%= @singular %>} label=<%= inspect(@gen.humanize(attribute.name)) %> field={<%= inspect(attribute.name) %>} sortable<%= if attribute.type in [:text, :map], do: ~s( class="max-w-xs truncate") %>>
        {format_value(<%= @singular %>.<%= attribute.name %>)}
      </:col><% end %><%= for relation <- @belongs_to do %>
      <:col :let={<%= @singular %>} label=<%= inspect(@gen.humanize(relation.name)) %>>
        {display_name(<%= @singular %>.<%= relation.name %>)}
      </:col><% end %>
      <:col :let={<%= @singular %>} label="Created" field={:inserted_at} sortable>
        {relative_time(<%= @singular %>.inserted_at)}
      </:col>
      <:action :let={<%= @singular %>} :if={@manager?}>
        <.link navigate={~p"/<%= @route %>/#{<%= @singular %>.id}/edit"} class="btn btn-ghost btn-xs">
          Edit
        </.link>
        <.button
          class="btn btn-ghost btn-xs text-error"
          phx-click="delete"
          phx-value-id={<%= @singular %>.id}
          data-confirm={"Delete #{display_name(<%= @singular %>)}?"}
        >
          Delete
        </.button>
      </:action>
      <:empty>
        <.empty_state icon=<%= inspect(@icon) %> title=<%= inspect("No " <> String.downcase(@human_plural) <> " yet") %>>
          <%= @human_plural %> of {@current_organization.name} show up here.
          <:action :if={@manager?}>
            <.link navigate={~p"/<%= @route %>/new"} class="btn btn-primary btn-sm">
              New <%= String.downcase(@human_singular) %>
            </.link>
          </:action>
        </.empty_state>
      </:empty>
    </.data_table>
  </Layouts.app>
  """
end
