# API rate limit, per node (see <%= inspect(@prefix) %>.RateLimit): API_RATE_LIMIT requests per
# API_RATE_WINDOW_MS for each API connection, signed-in user or client IP. The tests use
# the limit of config/test.exs and put their own value where they need one.
if config_env() != :test do
  config <%= inspect(@app) %>, <%= inspect(@prefix) %>.RateLimit,
    limit: String.to_integer(System.get_env("API_RATE_LIMIT", "600")),
    window_ms: String.to_integer(System.get_env("API_RATE_WINDOW_MS", "60000"))
end
