# Stripe (test mode locally). The defaults are placeholders: put real test keys
# and price ids in `.mise.local.toml`, never commit them. While they are
# placeholders `stripe_configured?` is false and the billing page says so.
#
#   STRIPE_SECRET_KEY      sk_test_…   Developers > API keys
#   STRIPE_PRICE_*         price_…     two recurring Prices (Product catalog)
#   STRIPE_WEBHOOK_SECRET  whsec_…     printed by `mise run stripe` (Stripe CLI)
config <%= inspect(@app) %>,
  plans: [
    %{
      key: "starter",
      name: "Starter",
      price_id: System.get_env("STRIPE_PRICE_STARTER", "price_replace_me"),
      description: "For small teams"
    },
    %{
      key: "pro",
      name: "Pro",
      price_id: System.get_env("STRIPE_PRICE_PRO", "price_replace_me"),
      description: "For growing teams"
    }
  ],
  stripe_webhook_secret: System.get_env("STRIPE_WEBHOOK_SECRET", "whsec_replace_me"),
  stripe_configured?:
    not String.ends_with?(System.get_env("STRIPE_SECRET_KEY", "sk_test_replace_me"), "replace_me")

config :stripity_stripe, api_key: System.get_env("STRIPE_SECRET_KEY", "sk_test_replace_me")
