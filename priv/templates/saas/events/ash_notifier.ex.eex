@moduledoc """
An `Ash.Notifier` that publishes every create, update and destroy of the
resources it is attached to (`notifiers: [<%= inspect(@prefix) %>.Events.AshNotifier]`) as an
event named `<resource short name>.<action name>`, for example
`organization.create` or `membership.change_role`.

The payload is the record's public attributes, so `public?` on an attribute also
means it is published: keep large or sensitive attributes private. A failed
publish is logged and never fails the action: the database write already
happened.
"""

use Ash.Notifier

require Logger

@impl true
def notify(%Ash.Notifier.Notification{resource: resource, action: action, data: data}) do
  type = "#{Ash.Resource.Info.short_name(resource)}.#{action.name}"

  case <%= inspect(@prefix) %>.Events.publish(type, payload(resource, data)) do
    :ok -> :ok
    {:error, reason} -> Logger.warning("could not publish #{type}: #{inspect(reason)}")
  end

  :ok
end

defp payload(resource, record) do
  resource
  |> Ash.Resource.Info.public_attributes()
  |> Map.new(fn attribute -> {attribute.name, Map.get(record, attribute.name)} end)
end
