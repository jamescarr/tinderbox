@moduledoc """
One in-app notification for one recipient. Created only by the Local adapter
(`authorize?: false`); recipients read and update their own.
"""

use Ash.Resource,
  otp_app: <%= inspect(@app) %>,
  domain: <%= inspect(@prefix) %>.Notifications,
  data_layer: AshPostgres.DataLayer,
  authorizers: [Ash.Policy.Authorizer]

postgres do
  table "notifications"
  repo <%= inspect(@repo) %>

  references do
    reference :recipient, on_delete: :delete
  end
end

actions do
  defaults [:read]

  create :deliver do
    accept [:key, :title, :body, :url, :data, :recipient_id]
  end

  update :mark_read do
    accept []
    require_atomic? false
    change set_attribute(:read_at, &DateTime.utc_now/0)
  end

  update :archive do
    accept []
    require_atomic? false
    change set_attribute(:archived_at, &DateTime.utc_now/0)
  end

  read :inbox do
    description "The actor's notifications that are not archived, newest first"
    filter expr(recipient_id == ^actor(:id) and is_nil(archived_at))
    prepare build(sort: [inserted_at: :desc])
  end

  read :unread do
    description "The actor's notifications that are neither read nor archived"
    filter expr(recipient_id == ^actor(:id) and is_nil(read_at) and is_nil(archived_at))
  end
end

policies do
  bypass actor_attribute_equals(:role, :admin) do
    authorize_if always()
  end

  policy action_type([:read, :update]) do
    authorize_if expr(recipient_id == ^actor(:id))
  end
end

attributes do
  uuid_primary_key :id

  attribute :key, :string, allow_nil?: false, public?: true
  attribute :title, :string, allow_nil?: false, public?: true
  attribute :body, :string, public?: true
  attribute :url, :string, public?: true
  attribute :data, :map, default: %{}, allow_nil?: false, public?: true
  attribute :read_at, :utc_datetime, public?: true
  attribute :archived_at, :utc_datetime, public?: true

  create_timestamp :inserted_at
end

relationships do
  belongs_to :recipient, <%= inspect(@user) %>, allow_nil?: false, public?: true
end
