@moduledoc """
Records for tests, written through the resources' own actions.
"""

alias <%= inspect(@accounts) %>.Membership
alias <%= inspect(@accounts) %>.Organization
alias <%= inspect(@user) %>
alias <%= inspect(@connection) %>
alias <%= inspect(@prefix) %>.Analytics.Event
alias <%= inspect(@prefix) %>.Waitlist.Signup

@password "password123!"

@doc "The password every `user_fixture/1` user signs in with."
def password, do: @password

@doc "A user registered with a password; `attrs` override the email and password."
def user_fixture(attrs \\ %{}) do
  params =
    Map.merge(
      %{
        email: "user#{System.unique_integer([:positive])}@example.com",
        password: @password,
        password_confirmation: @password
      },
      attrs
    )

  User
  |> Ash.Changeset.for_create(:register_with_password, params, authorize?: false)
  |> Ash.create!(authorize?: false)
end

@doc "A platform admin (`role: :admin`); `attrs` as for `user_fixture/1`."
def admin_fixture(attrs \\ %{}) do
  attrs
  |> user_fixture()
  |> Ash.update!(%{role: :admin}, action: :set_role, authorize?: false)
end

@doc "An address on the waitlist; `attrs` override the email and add a source, campaign…"
def signup_fixture(attrs \\ %{}) do
  Signup
  |> Ash.Changeset.for_create(
    :join,
    Map.merge(%{email: "lead#{System.unique_integer([:positive])}@example.com"}, attrs)
  )
  |> Ash.create!()
end

@doc """
An analytics event `name`; `attrs` set `anonymous_id`, `user_id`, `organization_id`,
`properties` or `occurred_at` (a past visit, say).
"""
def event_fixture(name, attrs \\ %{}) do
  Event
  |> Ash.Changeset.for_create(:record, Map.put(attrs, :name, name), authorize?: false)
  |> Ash.create!(authorize?: false)
end

@doc "An organization created by `user`, who becomes its owner."
def organization_fixture(user, attrs \\ %{}) do
  Organization
  |> Ash.Changeset.for_create(:create, Map.merge(%{name: "Acme"}, attrs), actor: user)
  |> Ash.create!(actor: user)
end

@doc "Adds `user` to `organization` with `role` (`:owner`, `:admin` or `:member`)."
def membership_fixture(organization, user, role) do
  Membership
  |> Ash.Changeset.for_create(:add, %{
    organization_id: organization.id,
    user_id: user.id,
    role: role
  })
  |> Ash.create!(authorize?: false)
end

@doc "An API connection of `organization` created by `user`, an owner or admin; the `fake` provider issues the client id."
def connection_fixture(organization, user, attrs \\ %{}) do
  Connection
  |> Ash.Changeset.for_create(
    :create,
    Map.merge(%{name: "CI", organization_id: organization.id}, attrs),
    actor: user
  )
  |> Ash.create!(actor: user)
end
