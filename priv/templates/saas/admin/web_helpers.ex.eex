
# The admin section uses Petal Components. They are kept apart from
# `html_helpers/0` (daisyUI + CoreComponents) because both export `button/1`,
# `table/1`, `icon/1` and more.
def admin_live_view do
  quote do
    use Phoenix.LiveView

    unquote(admin_html_helpers())
  end
end

def admin_html do
  quote do
    use Phoenix.Component

    unquote(admin_html_helpers())
  end
end

defp admin_html_helpers do
  quote do
<%= if @gettext? do %>    use Gettext, backend: <%= inspect(@web) %>.Gettext

<% end %>    # Petal Components, instead of CoreComponents
    use PetalComponents

    import Phoenix.HTML

    alias Phoenix.LiveView.JS
    alias <%= inspect(@web) %>.Layouts
    alias <%= inspect(@web) %>.Admin.Layouts, as: AdminLayouts

    unquote(verified_routes())
  end
end
