@moduledoc """
The admin section's layout: the app shell (`<%= inspect(@web) %>.UI.Shell`) with the admin
navigation, in the themepack's shape like the rest of the application.
"""

use <%= inspect(@web) %>, :html

@titles %{
  dashboard: "Dashboard",
  users: "Users",
  organizations: "Organizations",
  subscriptions: "Subscriptions"
}

attr :flash, :map, required: true
attr :current_user, :any, required: true
attr :current_page, :atom, required: true, values: [:dashboard, :users, :organizations, :subscriptions]

slot :inner_block, required: true

def admin(assigns) do
  assigns = assign(assigns, :title, Map.fetch!(@titles, assigns.current_page))

  ~H"""
  <.app_shell id="admin-shell" width={:wide}>
    <:brand>
      <.link navigate={~p"/admin"} class="flex items-center gap-2 font-display text-lg font-semibold">
        <.icon name="hero-shield-check" class="size-6 text-primary" /> <%= inspect(@prefix) %> admin
      </.link>
    </:brand>
    <:nav>
      <.nav_item navigate={~p"/admin"} icon="hero-home" active={@current_page == :dashboard}>
        Dashboard
      </.nav_item>
      <.nav_item navigate={~p"/admin/users"} icon="hero-users" active={@current_page == :users}>
        Users
      </.nav_item>
      <.nav_item
        navigate={~p"/admin/organizations"}
        icon="hero-building-office"
        active={@current_page == :organizations}
      >
        Organizations
      </.nav_item>
      <.nav_item
        navigate={~p"/admin/subscriptions"}
        icon="hero-credit-card"
        active={@current_page == :subscriptions}
      >
        Subscriptions
      </.nav_item>
      <.nav_item href={~p"/admin/flags"} icon="hero-flag">Feature flags</.nav_item>
    </:nav>
    <:nav_footer>
      <.nav_item href={~p"/dashboard"} icon="hero-arrow-left-start-on-rectangle">
        Back to app
      </.nav_item>
    </:nav_footer>
    <:topbar>
      <Layouts.theme_toggle />
      <.user_menu name={to_string(@current_user.email)}>
        <:item href={~p"/sign-out"}>Sign out</:item>
      </.user_menu>
    </:topbar>

    <.page_header>{@title}</.page_header>
    {render_slot(@inner_block)}
  </.app_shell>

  <Layouts.flash_group flash={@flash} />
  """
end
