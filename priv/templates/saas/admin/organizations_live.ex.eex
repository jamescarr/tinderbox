@moduledoc """
Admin: every organization with its member count and plan.
"""

use <%= inspect(@web) %>, :live_view

alias <%= inspect(@accounts) %>.Organization
alias <%= inspect(@web) %>.Admin.Layouts, as: AdminLayouts

on_mount {<%= inspect(@web) %>.LiveUserAuth, :live_user_required}
on_mount {<%= inspect(@web) %>.LiveAdmin, :require_admin}

@limit 1000

@impl true
def mount(_params, _session, socket) do
  rows =
    Organization
    |> Ash.Query.load([:member_count, :subscription])
    |> Ash.Query.sort(inserted_at: :desc)
    |> Ash.Query.limit(@limit)
    |> Ash.read!(actor: socket.assigns.current_user)
    |> Enum.map(fn organization ->
      %{
        id: organization.id,
        name: organization.name,
        slug: organization.slug,
        member_count: organization.member_count,
        plan_key: organization.subscription && organization.subscription.plan_key,
        status: organization.subscription && organization.subscription.status,
        inserted_at: organization.inserted_at
      }
    end)

  state =
    ListState.new(
      search_fields: [:name, :slug],
      sortable: [:name, :slug, :member_count, :plan_key, :status, :inserted_at],
      sort_by: :inserted_at,
      sort_dir: :desc,
      page_size: 25
    )

  {:ok,
   socket
   |> assign(:page_title, "Organizations")
   |> assign(:all_rows, rows)
   |> run(state)}
end

@impl true
def handle_event("table", params, socket) do
  {:noreply, run(socket, ListState.update(socket.assigns.table, params))}
end

defp run(socket, state) do
  {rows, state} = ListState.run(socket.assigns.all_rows, state)
  assign(socket, rows: rows, table: state)
end

@impl true
def render(assigns) do
  ~H"""
  <AdminLayouts.admin flash={@flash} current_user={@current_user} current_page={:organizations}>
    <.data_table
      id="organizations"
      rows={@rows}
      state={@table}
      searchable
      search_placeholder="Search by name or slug…"
      row_id={&"organization-#{&1.id}"}
    >
      <:col :let={row} label="Name" field={:name} sortable>
        <div class="flex items-center gap-3">
          <.avatar name={row.name} />
          <span class="font-medium">{row.name}</span>
        </div>
      </:col>
      <:col :let={row} label="Slug" field={:slug} sortable>
        <span class="font-mono text-xs">{row.slug}</span>
      </:col>
      <:col :let={row} label="Members" field={:member_count} sortable align={:right}>
        {row.member_count}
      </:col>
      <:col :let={row} label="Plan" field={:plan_key} sortable>{row.plan_key || "—"}</:col>
      <:col :let={row} label="Status" field={:status} sortable>
        <.status_badge :if={row.status} status={row.status} />
        <span :if={!row.status} class="text-base-content/50">—</span>
      </:col>
      <:col :let={row} label="Created" field={:inserted_at} sortable>
        {format_datetime(row.inserted_at)}
      </:col>
      <:action :let={row}>
        <.link navigate={~p"/admin/organizations/#{row.id}"} class="btn btn-ghost btn-xs">
          View
        </.link>
      </:action>
    </.data_table>
  </AdminLayouts.admin>
  """
end
