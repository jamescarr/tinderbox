@moduledoc """
Admin: every subscription synced from Stripe.
"""

use <%= inspect(@web) %>, :live_view

alias <%= inspect(@prefix) %>.Billing.Subscription
alias <%= inspect(@web) %>.Admin.Layouts, as: AdminLayouts

on_mount {<%= inspect(@web) %>.LiveUserAuth, :live_user_required}
on_mount {<%= inspect(@web) %>.LiveAdmin, :require_admin}

@limit 1000

@impl true
def mount(_params, _session, socket) do
  rows =
    Subscription
    |> Ash.Query.load(:organization)
    |> Ash.Query.sort(inserted_at: :desc)
    |> Ash.Query.limit(@limit)
    |> Ash.read!(actor: socket.assigns.current_user)
    |> Enum.map(fn subscription ->
      %{
        id: subscription.id,
        organization_id: subscription.organization_id,
        organization_name: subscription.organization.name,
        plan_key: subscription.plan_key,
        status: subscription.status,
        current_period_end: subscription.current_period_end,
        cancel_at_period_end: subscription.cancel_at_period_end,
        stripe_subscription_id: subscription.stripe_subscription_id
      }
    end)

  state =
    ListState.new(
      search_fields: [:organization_name, :plan_key, :stripe_subscription_id],
      sortable: [
        :organization_name,
        :plan_key,
        :status,
        :current_period_end,
        :cancel_at_period_end
      ],
      sort_by: :current_period_end,
      sort_dir: :desc,
      page_size: 25
    )

  {:ok,
   socket
   |> assign(:page_title, "Subscriptions")
   |> assign(:all_rows, rows)
   |> run(state)}
end

@impl true
def handle_event("table", params, socket) do
  {:noreply, run(socket, ListState.update(socket.assigns.table, params))}
end

defp run(socket, state) do
  {rows, state} = ListState.run(socket.assigns.all_rows, state)
  assign(socket, rows: rows, table: state)
end

defp date(nil), do: "—"
defp date(datetime), do: Calendar.strftime(datetime, "%Y-%m-%d")

@impl true
def render(assigns) do
  ~H"""
  <AdminLayouts.admin flash={@flash} current_user={@current_user} current_page={:subscriptions}>
    <.data_table
      id="subscriptions"
      rows={@rows}
      state={@table}
      searchable
      search_placeholder="Search subscriptions…"
      row_id={&"subscription-#{&1.id}"}
    >
      <:col :let={row} label="Organization" field={:organization_name} sortable>
        <.link
          navigate={~p"/admin/organizations/#{row.organization_id}"}
          class="font-medium hover:text-primary"
        >
          {row.organization_name}
        </.link>
      </:col>
      <:col :let={row} label="Plan" field={:plan_key} sortable>{row.plan_key || "—"}</:col>
      <:col :let={row} label="Status" field={:status} sortable>
        <.status_badge status={row.status} />
      </:col>
      <:col :let={row} label="Period ends" field={:current_period_end} sortable>
        {date(row.current_period_end)}
      </:col>
      <:col :let={row} label="Cancels" field={:cancel_at_period_end} sortable>
        <.badge :if={row.cancel_at_period_end} color="warning">At period end</.badge>
        <span :if={!row.cancel_at_period_end} class="text-base-content/50">No</span>
      </:col>
      <:col :let={row} label="Stripe id">
        <code class="font-mono text-xs">{row.stripe_subscription_id}</code>
      </:col>
    </.data_table>
  </AdminLayouts.admin>
  """
end
