@moduledoc """
Admin: one organization, with its members, subscription and pending invitations.
"""

use <%= inspect(@web) %>, :live_view

alias <%= inspect(@accounts) %>.Organization
alias <%= inspect(@web) %>.Admin.Layouts, as: AdminLayouts

on_mount {<%= inspect(@web) %>.LiveUserAuth, :live_user_required}
on_mount {<%= inspect(@web) %>.LiveAdmin, :require_admin}

@impl true
def mount(%{"id" => id}, _session, socket) do
  organization =
    Ash.get!(Organization, id,
      actor: socket.assigns.current_user,
      load: [:subscription, memberships: :user, invitations: []]
    )

  {:ok,
   socket
   |> assign(:page_title, organization.name)
   |> assign(:organization, organization)
   |> assign(:pending, Enum.filter(organization.invitations, &is_nil(&1.accepted_at)))}
end

@impl true
def render(assigns) do
  ~H"""
  <AdminLayouts.admin flash={@flash} current_user={@current_user} current_page={:organizations}>
    <div class="space-y-6">
      <.card id="organization">
        <:title>{@organization.name}</:title>
        <:actions>
          <.link navigate={~p"/admin/organizations"} class="btn btn-ghost btn-sm">
            <.icon name="hero-arrow-left-micro" class="size-4" /> All organizations
          </.link>
        </:actions>
        <.description_list>
          <:item label="Slug"><span class="font-mono text-xs">{@organization.slug}</span></:item>
          <:item label="Created">{format_datetime(@organization.inserted_at)}</:item>
          <:item label="Stripe customer">{@organization.stripe_customer_id || "—"}</:item>
        </.description_list>
      </.card>

      <.card id="subscription">
        <:title>Subscription</:title>
        <.description_list :if={@organization.subscription}>
          <:item label="Plan">{@organization.subscription.plan_key || "—"}</:item>
          <:item label="Status"><.status_badge status={@organization.subscription.status} /></:item>
          <:item label="Period ends">
            {format_datetime(@organization.subscription.current_period_end)}
          </:item>
          <:item label="Stripe subscription">
            <code class="font-mono text-xs">{@organization.subscription.stripe_subscription_id}</code>
          </:item>
        </.description_list>
        <.empty_state
          :if={!@organization.subscription}
          icon="hero-credit-card"
          title="No subscription"
        >
          This organization has not chosen a plan.
        </.empty_state>
      </.card>

      <.card>
        <:title>Members</:title>
        <.table id="members" rows={@organization.memberships}>
          <:col :let={membership} label="Email">
            <div class="flex items-center gap-3">
              <.avatar name={to_string(membership.user.email)} />
              {to_string(membership.user.email)}
            </div>
          </:col>
          <:col :let={membership} label="Role"><.badge>{membership.role}</.badge></:col>
          <:col :let={membership} label="Joined">{format_datetime(membership.inserted_at)}</:col>
        </.table>
      </.card>

      <.card>
        <:title>Pending invitations</:title>
        <.table :if={@pending != []} id="invitations" rows={@pending}>
          <:col :let={invitation} label="Email">{to_string(invitation.email)}</:col>
          <:col :let={invitation} label="Role"><.badge>{invitation.role}</.badge></:col>
          <:col :let={invitation} label="Expires">{format_datetime(invitation.expires_at)}</:col>
        </.table>
        <.empty_state :if={@pending == []} icon="hero-envelope" title="No pending invitations" />
      </.card>
    </div>
  </AdminLayouts.admin>
  """
end
