# Mail goes to an SMTP server: Mailpit locally (http://localhost:8025 shows the
# inbox), your provider's relay in production. `config/test.exs` keeps
# `Swoosh.Adapters.Test` so tests never send anything.
if config_env() != :test do
  config <%= inspect(@app) %>, <%= inspect(@mailer) %>,
    adapter: Swoosh.Adapters.SMTP,
    relay: System.get_env("SMTP_HOST", "localhost"),
    port: String.to_integer(System.get_env("SMTP_PORT", "1025")),
    tls: :never,
    auth: :never,
    retries: 1
end
