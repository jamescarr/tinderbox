create :register_with_sso do
  description "Registers (or signs in) a user from an OIDC identity-provider login"

  argument :user_info, :map, allow_nil?: false
  argument :oauth_tokens, :map, allow_nil?: false, sensitive?: true

  upsert? true
  upsert_identity :unique_email
  # Required with the password + confirmation strategies: an existing account is
  # left exactly as it is.
  upsert_fields []

  change AshAuthentication.GenerateTokenChange

  # Persists the provider's `iss`/`sub` claims in the user identity resource.
  change AshAuthentication.Strategy.OAuth2.IdentityChange

  change fn changeset, _context ->
    user_info = Ash.Changeset.get_argument(changeset, :user_info)

    Ash.Changeset.change_attributes(changeset, Map.take(user_info, ["email"]))
  end

  change set_attribute(:confirmed_at, &DateTime.utc_now/0)
end
