defmodule <%= inspect(@mfa) %>Test do
  use <%= inspect(@prefix) %>.DataCase, async: false

  import <%= inspect(@prefix) %>.Fixtures

  alias <%= inspect(@mfa) %>
  alias <%= inspect(@record_sso_assurance) %>

  setup do
    # A code computed in one 30 second period must not be checked in the next.
    safe_window()

    original = Application.get_env(<%= inspect(@app) %>, MFA)

    on_exit(fn ->
      if original,
        do: Application.put_env(<%= inspect(@app) %>, MFA, original),
        else: Application.delete_env(<%= inspect(@app) %>, MFA)
    end)

    # The tests do not depend on the environment they run in.
    put_config(required: false, sso: :local, sso_mfa_amr: ["mfa"], sso_mfa_acr: [])

    %{user: user_fixture()}
  end

  describe "enrolling" do
    test "a wrong code is refused, and the previous period's code confirms", %{user: user} do
      secret = enroll_secret(user)

      assert {:error, :invalid_code} = MFA.confirm_enrollment(user, wrong_code(secret))
      refute MFA.enrolled?(user)

      assert {:ok, codes} = MFA.confirm_enrollment(user, code(secret, -30))
      assert length(codes) == 10
      assert MFA.enrolled?(user)
      assert MFA.status(user).recovery_codes_left == 10
      assert {:error, :already_enrolled} = MFA.begin_enrollment(user)
    end

    test "a refresh shows the same secret, and cancelling forgets it", %{user: user} do
      secret = enroll_secret(user)
      assert enroll_secret(user) == secret

      assert :ok = MFA.cancel_enrollment(user)
      refute MFA.enrolled?(user)
      assert {:error, :not_started} = MFA.confirm_enrollment(user, code(secret, 0))
    end
  end

  describe "verifying" do
    test "a code works once", %{user: user} do
      secret = enroll_secret(user)
      confirm!(user, secret)

      assert :ok = MFA.verify(user, code(secret, 0))
      assert {:error, :invalid_code} = MFA.verify(user, code(secret, 0))
    end

    test "a recovery code works once, in any case and grouping", %{user: user} do
      secret = enroll_secret(user)
      [first, second | _rest] = confirm!(user, secret)

      assert :ok = MFA.verify(user, first)
      assert {:error, :invalid_code} = MFA.verify(user, first)
      assert MFA.status(user).recovery_codes_left == 9

      assert :ok = MFA.verify(user, second |> String.upcase() |> String.replace("-", " "))
      assert MFA.status(user).recovery_codes_left == 8
    end

    test "ten wrong codes lock the factor, even against the right code", %{user: user} do
      secret = enroll_secret(user)
      confirm!(user, secret)
      {nine, [tenth]} = secret |> wrong_codes() |> Enum.take(10) |> Enum.split(9)

      assert Enum.map(nine, &MFA.verify(user, &1)) == List.duplicate({:error, :invalid_code}, 9)
      assert {:error, :locked} = MFA.verify(user, tenth)
      assert {:error, :locked} = MFA.verify(user, code(secret, 0))
      assert %DateTime{} = MFA.status(user).locked_until
    end

    test "a user without a factor has nothing to verify", %{user: user} do
      assert {:error, :not_enrolled} = MFA.verify(user, "123456")
    end
  end

  describe "recovery codes" do
    test "replacing them needs a code and retires the old ones", %{user: user} do
      secret = enroll_secret(user)
      [old | _rest] = confirm!(user, secret)

      assert {:error, :invalid_code} =
               MFA.regenerate_recovery_codes(user, wrong_code(secret))

      assert {:ok, new} = MFA.regenerate_recovery_codes(user, code(secret, 0))
      assert length(new) == 10
      assert {:error, :invalid_code} = MFA.verify(user, old)
      assert :ok = MFA.verify(user, hd(new))
    end
  end

  describe "turning it off" do
    test "needs a code, and the administrator's reset does not", %{user: user} do
      secret = enroll_secret(user)
      confirm!(user, secret)

      assert {:error, :invalid_code} = MFA.disable(user, wrong_code(secret))
      assert MFA.enrolled?(user)

      assert :ok = MFA.disable(user, code(secret, 0))
      refute MFA.enrolled?(user)

      secret = enroll_secret(user)
      confirm!(user, secret)
      assert :ok = MFA.reset(user)
      refute MFA.enrolled?(user)
    end

    test "is refused when two-factor authentication is required", %{user: user} do
      secret = enroll_secret(user)
      confirm!(user, secret)
      put_config(required: true)

      assert {:error, :required} = MFA.disable(user, code(secret, 0))
      assert MFA.enrolled?(user)
    end
  end

  describe "sign_in_step/2" do
    test "follows the user's factor and the requirement", %{user: user} do
      assert MFA.sign_in_step(user, {:password, :sign_in}) == :complete

      put_config(required: true)
      assert MFA.sign_in_step(user, {:password, :sign_in}) == :enroll

      confirm!(user, enroll_secret(user))
      assert MFA.sign_in_step(user, {:password, :sign_in}) == :challenge
    end

    test "the identity provider's MFA counts only with MFA_SSO=idp", %{user: user} do
      confirm!(user, enroll_secret(user))

      asserted = fn amr, acr ->
        Ash.Resource.put_metadata(user, :sso_assurance, %{amr: amr, acr: acr})
      end

      # `local` (the default): the second factor is asked for after SSO as well.
      assert MFA.sign_in_step(asserted.(["pwd", "mfa"], nil), {:sso, :callback}) == :challenge

      put_config(sso: :idp, sso_mfa_acr: ["urn:okta:loa:2fa:any"])

      assert MFA.sign_in_step(asserted.(["pwd", "mfa"], nil), {:sso, :callback}) == :complete
      assert MFA.sign_in_step(asserted.([], "urn:okta:loa:2fa:any"), {:sso, :callback}) == :complete
      assert MFA.sign_in_step(asserted.(["pwd"], "urn:okta:loa:1fa"), {:sso, :callback}) == :challenge
      assert MFA.sign_in_step(user, {:sso, :callback}) == :challenge

      # Only an SSO sign-in can be vouched for by the provider.
      assert MFA.sign_in_step(asserted.(["mfa"], nil), {:password, :sign_in}) == :challenge
    end
  end

  describe "the ID token's assurance" do
    test "amr and acr are read from the claims" do
      token = jwt(%{"amr" => ["pwd", "mfa"], "acr" => "x"})

      assert RecordSsoAssurance.assurance(%{"id_token" => token}) ==
               %{amr: ["pwd", "mfa"], acr: "x"}
    end

    test "a single amr value is a list, and no token means no assurance" do
      assert RecordSsoAssurance.assurance(%{"id_token" => jwt(%{"amr" => "mfa"})}) ==
               %{amr: ["mfa"], acr: nil}

      assert RecordSsoAssurance.assurance(%{"id_token" => "not a token"}) == %{amr: [], acr: nil}
      assert RecordSsoAssurance.assurance(%{}) == %{amr: [], acr: nil}
    end
  end

  # -- helpers --------------------------------------------------------------

  defp safe_window do
    if rem(System.os_time(:second), 30) > 27, do: Process.sleep(3_000)
  end

  defp put_config(overrides) do
    config = Application.get_env(<%= inspect(@app) %>, MFA, [])
    Application.put_env(<%= inspect(@app) %>, MFA, Keyword.merge(config, overrides))
  end

  defp enroll_secret(user) do
    {:ok, enrollment} = MFA.begin_enrollment(user)
    secret_from(enrollment)
  end

  defp secret_from(enrollment) do
    enrollment.uri
    |> URI.parse()
    |> Map.fetch!(:query)
    |> URI.decode_query()
    |> Map.fetch!("secret")
    |> Base.decode32!(padding: false)
  end

  # Confirms with the previous period's code, so the current period's code is
  # still unused afterwards. Returns the recovery codes.
  defp confirm!(user, secret) do
    {:ok, codes} = MFA.confirm_enrollment(user, code(secret, -30))
    codes
  end

  defp code(secret, offset) do
    NimbleTOTP.verification_code(secret, time: System.os_time(:second) + offset)
  end

  defp wrong_code(secret), do: secret |> wrong_codes() |> Enum.at(0)

  # Six-digit strings that are neither the current, the previous nor the next code.
  defp wrong_codes(secret) do
    valid = Enum.map([-30, 0, 30], &code(secret, &1))

    0
    |> Stream.iterate(&(&1 + 1))
    |> Stream.map(&(&1 |> Integer.to_string() |> String.pad_leading(6, "0")))
    |> Stream.reject(&(&1 in valid))
  end

  # An unsigned token: only the claims are read.
  defp jwt(claims) do
    encode = &Base.url_encode64(Jason.encode!(&1), padding: false)
    encode.(%{"alg" => "none"}) <> "." <> encode.(claims) <> "."
  end
end
