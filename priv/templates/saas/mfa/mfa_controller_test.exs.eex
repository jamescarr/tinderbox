defmodule <%= inspect(@web) %>.MfaControllerTest do
  use <%= inspect(@web) %>.ConnCase, async: false

  import <%= inspect(@prefix) %>.Fixtures
  import <%= inspect(@prefix) %>.MFATestHelpers

  alias <%= inspect(@mfa) %>

  setup do
    mfa_test_env()
    %{user: user_fixture()}
  end

  describe "after the first step" do
    test "an enrolled user is not signed in, and the sign-in token is revoked", %{
      conn: conn,
      user: user
    } do
      enroll!(user)
      token = user.__metadata__.token

      conn =
        conn
        |> bypass_through(<%= inspect(@web) %>.Router, [:browser])
        |> get("/")
        |> <%= inspect(@web) %>.AuthController.success({:password, :sign_in}, user, nil)

      assert redirected_to(conn) == "/mfa"
      assert get_session(conn, "user_token") == nil
      assert AshAuthentication.TokenResource.token_revoked?(<%= inspect(@token) %>, token)
    end

    test "a user without a factor is signed in straight away", %{conn: conn, user: user} do
      conn =
        conn
        |> bypass_through(<%= inspect(@web) %>.Router, [:browser])
        |> get("/")
        |> <%= inspect(@web) %>.AuthController.success({:password, :sign_in}, user, nil)

      assert redirected_to(conn) == "/"
      assert get_session(conn, "user_token")
    end
  end

  describe "the code prompt" do
    test "the right code signs in and goes where the user was headed", %{conn: conn, user: user} do
      {secret, _codes} = enroll!(user)

      conn =
        conn
        |> init_test_session(%{mfa_pending: pending(user)})
        |> post(~p"/mfa", %{"mfa" => %{"code" => code(secret, 0)}})

      assert redirected_to(conn) == "/dashboard"
      assert get_session(conn, "user_token")
      assert get_session(conn, "mfa_pending") == nil
    end

    test "a wrong code is refused and nothing is signed in", %{conn: conn, user: user} do
      {secret, _codes} = enroll!(user)

      conn =
        conn
        |> init_test_session(%{mfa_pending: pending(user)})
        |> post(~p"/mfa", %{"mfa" => %{"code" => wrong_code(secret)}})

      assert html_response(conn, 422) =~ "not valid"
      assert get_session(conn, "user_token") == nil
      assert get_session(conn, "mfa_pending")
    end

    test "a sign-in left for more than ten minutes expires", %{conn: conn, user: user} do
      {secret, _codes} = enroll!(user)
      started_at = System.os_time(:second) - 601

      conn =
        conn
        |> init_test_session(%{mfa_pending: pending(user, started_at: started_at)})
        |> post(~p"/mfa", %{"mfa" => %{"code" => code(secret, 0)}})

      assert redirected_to(conn) == "/sign-in"
      assert get_session(conn, "user_token") == nil
    end

    test "without a sign-in in progress it goes back to the sign-in page", %{conn: conn} do
      assert conn |> get(~p"/mfa") |> redirected_to() == "/sign-in"
    end
  end

  describe "setting a factor up" do
    test "shows the key, and the first code signs in and shows the recovery codes", %{
      conn: conn,
      user: user
    } do
      conn = init_test_session(conn, %{mfa_pending: pending(user, step: "enroll")})

      assert conn |> get(~p"/mfa/setup") |> html_response(200) =~ "mfa-manual-key"

      secret = start_enrollment!(user)

      conn = post(conn, ~p"/mfa/setup", %{"mfa" => %{"code" => code(secret, 0)}})

      assert html_response(conn, 200) =~ "recovery-codes"
      assert get_session(conn, "user_token")
      assert MFA.enrolled?(user)
    end

    test "a wrong first code shows the same key again", %{conn: conn, user: user} do
      conn = init_test_session(conn, %{mfa_pending: pending(user, step: "enroll")})

      assert conn |> get(~p"/mfa/setup") |> html_response(200)
      secret = start_enrollment!(user)
      conn = post(conn, ~p"/mfa/setup", %{"mfa" => %{"code" => wrong_code(secret)}})

      assert html_response(conn, 422) =~ "mfa-manual-key"
      assert get_session(conn, "user_token") == nil
      refute MFA.enrolled?(user)
    end
  end

  defp pending(user, opts \\ []) do
    %{
      "user_id" => user.id,
      "step" => Keyword.get(opts, :step, "challenge"),
      "return_to" => "/dashboard",
      "started_at" => Keyword.get(opts, :started_at, System.os_time(:second))
    }
  end
end
