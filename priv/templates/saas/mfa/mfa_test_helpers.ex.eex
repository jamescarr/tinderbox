@moduledoc """
What the two-factor authentication tests share: a known configuration, enrolling
a user, and computing right and wrong codes for a secret.
"""

import ExUnit.Callbacks, only: [on_exit: 1]

alias <%= inspect(@mfa) %>

@doc """
For a test's `setup`: waits out the end of a 30 second step, so a code computed
in one step is not checked in the next, and puts a configuration that does not
depend on the environment the tests run in, restored when the test exits.
"""
def mfa_test_env do
  if rem(System.os_time(:second), 30) > 27, do: Process.sleep(3_000)

  original = Application.get_env(<%= inspect(@app) %>, MFA)

  on_exit(fn ->
    if original,
      do: Application.put_env(<%= inspect(@app) %>, MFA, original),
      else: Application.delete_env(<%= inspect(@app) %>, MFA)
  end)

  put_mfa_config(required: false, sso: :local, sso_mfa_amr: ["mfa"], sso_mfa_acr: [])
  :ok
end

@doc "Merges `overrides` into the `<%= inspect(@mfa) %>` configuration."
def put_mfa_config(overrides) do
  config = Application.get_env(<%= inspect(@app) %>, MFA, [])
  Application.put_env(<%= inspect(@app) %>, MFA, Keyword.merge(config, overrides))
end

@doc "Starts (or resumes) enrolling `user`; returns the secret."
def start_enrollment!(user) do
  {:ok, enrollment} = MFA.begin_enrollment(user)
  secret_from(enrollment)
end

@doc """
Confirms the enrollment with the previous step's code, so the current step's
code is still unused afterwards. Returns the recovery codes.
"""
def confirm!(user, secret) do
  {:ok, codes} = MFA.confirm_enrollment(user, code(secret, -30))
  codes
end

@doc "Gives `user` a confirmed factor; returns its secret and recovery codes."
def enroll!(user) do
  secret = start_enrollment!(user)
  {secret, confirm!(user, secret)}
end

@doc "The code for `secret`, `offset` seconds from now."
def code(secret, offset \\ 0) do
  NimbleTOTP.verification_code(secret, time: System.os_time(:second) + offset)
end

@doc "A six-digit code that is not valid for `secret`."
def wrong_code(secret), do: secret |> wrong_codes() |> Enum.at(0)

@doc "Six-digit strings that are neither the current, the previous nor the next code."
def wrong_codes(secret) do
  valid = Enum.map([-30, 0, 30], &code(secret, &1))

  0
  |> Stream.iterate(&(&1 + 1))
  |> Stream.map(&(&1 |> Integer.to_string() |> String.pad_leading(6, "0")))
  |> Stream.reject(&(&1 in valid))
end

@doc "The secret of an enrollment, from its `otpauth://` URI."
def secret_from(enrollment) do
  enrollment.uri
  |> URI.parse()
  |> Map.fetch!(:query)
  |> URI.decode_query()
  |> Map.fetch!("secret")
  |> Base.decode32!(padding: false)
end
